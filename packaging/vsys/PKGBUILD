# Maintainer: VanillaGreen <brad@vanillagreen.com>
pkgname=vsys
pkgver=0.9.0
pkgrel=1
pkgdesc="Terminal dashboard for Linux machines that run AI agents"
arch=('x86_64' 'aarch64')
url="https://github.com/vanillagreencom/vsys"
license=('MIT')
depends=('python' 'systemd' 'systemd-libs')
optdepends=('udisks2: drive lifetime writes where no smart report exists'
	'tmux: lane pane reads and the jump to a lane'
	'libnotify: desktop notifications for alerts'
	'sccache: build cache statistics'
	'btrfs-progs: the scrub reporter, which writes the damaged-file report'
	'smartmontools: the smart reporter, which writes drive lifetime writes')
provides=('vsys')
conflicts=('vsys-git')
options=('!strip' '!debug')
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/vsys-v${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/vsys-v${pkgver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
	install -Dm755 "${srcdir}/vsys" "${pkgdir}/usr/bin/vsys"
	cp -R --no-preserve=ownership "${srcdir}/lib" "${pkgdir}/usr/"
	install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
