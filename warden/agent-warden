class AgentToolsError(Exception):
    def __init__(self, kind, path, reason="", paths=()):
        super().__init__(reason)
        self.kind = kind
        self.path = path
        self.reason = reason
        self.paths = tuple(paths)


def _invalid_agent_tools(path, reason):
    return AgentToolsError("invalid", str(path), reason)


def _object(value, path, context):
    if not isinstance(value, dict):
        raise _invalid_agent_tools(path, f"{context} must be an object")
    return value


def _reject_unknown_keys(value, allowed, path, context):
    for key in value:
        if key not in allowed:
            raise _invalid_agent_tools(path, f"{context} has unknown key {key}")


def _string_array(value, path, context, valid, rule):
    if not isinstance(value, list):
        raise _invalid_agent_tools(path, f"{context} must be an array")
    out = []
    for index, item in enumerate(value):
        if not isinstance(item, str) or not valid(item):
            raise _invalid_agent_tools(path, f"{context}[{index}] {rule}")
        out.append(item)
    return out


def _reject_duplicate(seen, value, path, context):
    if value in seen:
        raise _invalid_agent_tools(path, f"{context} duplicates {value}")
    seen.add(value)


def _parse_agent_tools(value, path):
    value = _object(value, path, "document")
    _reject_unknown_keys(value, {"version", "tools", "desktopExePrefixes", "bundledCliSuffixes"}, path, "document")
    version = value.get("version")
    if isinstance(version, bool) or not isinstance(version, (int, float)) or version != 1:
        raise _invalid_agent_tools(path, "version must be 1")
    tools_raw = value.get("tools")
    if not isinstance(tools_raw, list):
        raise _invalid_agent_tools(path, "tools must be an array")
    names, mise_dirs = set(), set()
    tools = []
    for index, raw_tool in enumerate(tools_raw):
        tool = _object(raw_tool, path, f"tools[{index}]")
        _reject_unknown_keys(tool, {"name", "mise", "paths", "executables"}, path, f"tools[{index}]")
        name = tool.get("name")
        if not isinstance(name, str) or not name or re.search(r"\s", name) or "/" in name:
            raise _invalid_agent_tools(path, f"tools[{index}].name is invalid")
        _reject_duplicate(names, name, path, "tool name")
        mise = [] if "mise" not in tool else _string_array(
            tool["mise"], path, f"tools[{index}].mise",
            lambda item: re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", item) is not None,
            "must be a mise install directory name")
        for directory in mise:
            _reject_duplicate(mise_dirs, directory, path, "mise dir")
        # The dashboard confirms an agent's name by these install locations;
        # the warden only refuses a document that holds a malformed one. A
        # repeated location is refused when the documents merge.
        tool_paths = [] if "paths" not in tool else _string_array(
            tool["paths"], path, f"tools[{index}].paths",
            lambda item: len(item) > 1 and item.startswith("/"),
            "must be a path fragment starting with /")
        executables = [] if "executables" not in tool else _string_array(
            tool["executables"], path, f"tools[{index}].executables",
            lambda item: len(item) > 1 and item.startswith("/") and not item.endswith("/"),
            "must be an absolute executable path")
        tools.append({"name": name, "mise": mise, "paths": tool_paths, "executables": executables})
    prefixes = _string_array(value.get("desktopExePrefixes", []), path, "desktopExePrefixes",
                             lambda item: bool(item) and item.startswith("/"),
                             "must be a nonempty absolute path prefix")
    suffixes = _string_array(value.get("bundledCliSuffixes", []), path, "bundledCliSuffixes",
                             lambda item: bool(item) and item.startswith("/"),
                             "must be a nonempty absolute path suffix")
    seen_prefixes, seen_suffixes = set(), set()
    for prefix in prefixes:
        _reject_duplicate(seen_prefixes, prefix, path, "desktop exe prefix")
    for suffix in suffixes:
        _reject_duplicate(seen_suffixes, suffix, path, "bundled cli suffix")
    return {"tools": tools, "desktopExePrefixes": prefixes, "bundledCliSuffixes": suffixes}


def _read_agent_tools(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return _parse_agent_tools(json.load(handle), str(path))
    except json.JSONDecodeError as error:
        raise _invalid_agent_tools(path, error.msg) from error
    except UnicodeDecodeError as error:
        raise _invalid_agent_tools(path, str(error)) from error
    except OSError as error:
        if error.errno == errno.ENOENT:
            raise
        raise _invalid_agent_tools(path, str(error)) from error


def _merge_agent_tools(documents):
    merged = {"tools": [], "desktopExePrefixes": [], "bundledCliSuffixes": []}
    tools, locations, mise_dirs, prefixes, suffixes = {}, {}, set(), set(), set()
    for path, document in documents:
        for tool in document["tools"]:
            # An overlay entry naming a listed tool adds to that tool, as the
            # dashboard merges it.
            entry = tools.get(tool["name"])
            if entry is None:
                entry = tools[tool["name"]] = {"name": tool["name"], "mise": [], "paths": [], "executables": []}
                locations[tool["name"]] = set()
                merged["tools"].append(entry)
            for directory in tool["mise"]:
                _reject_duplicate(mise_dirs, directory, path, "mise dir")
                entry["mise"].append(directory)
            for fragment in tool["paths"]:
                _reject_duplicate(locations[tool["name"]], fragment, path, f"{tool['name']} paths")
                entry["paths"].append(fragment)
            for executable in tool["executables"]:
                _reject_duplicate(locations[tool["name"]], executable, path, f"{tool['name']} executables")
                entry["executables"].append(executable)
        for prefix in document["desktopExePrefixes"]:
            _reject_duplicate(prefixes, prefix, path, "desktop exe prefix")
            merged["desktopExePrefixes"].append(prefix)
        for suffix in document["bundledCliSuffixes"]:
            _reject_duplicate(suffixes, suffix, path, "bundled cli suffix")
            merged["bundledCliSuffixes"].append(suffix)
    return merged


def _agent_tools_paths():
    repo = Path(__file__).resolve().parent.parent / "data" / "agent-tools.json"
    installed = Path(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share")) / "vsys" / "agent-tools.json"
    return repo, installed


def _load_agent_tools():
    repo_path, installed_path = _agent_tools_paths()
    if repo_path.exists():
        shipped_path = repo_path
    elif installed_path.exists():
        shipped_path = installed_path
    else:
        raise AgentToolsError("missing", "", paths=(str(repo_path), str(installed_path)))
    shipped = _read_agent_tools(shipped_path)
    documents = [(str(shipped_path), shipped)]
    overlay_path = Path(HOME) / ".config" / "vsys" / "agent-tools.json"
    try:
        overlay = _read_agent_tools(overlay_path)
    except FileNotFoundError:
        overlay = None
    if overlay is not None:
        documents.append((str(overlay_path), overlay))
    return _merge_agent_tools(documents)


