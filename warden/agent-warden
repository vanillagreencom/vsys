def parse_status_interval(raw):
    try:
        value = float(raw)
    except (TypeError, ValueError):
        print(f"invalid AGENT_WARDEN_INTERVAL={raw!r}; using 30", flush=True)
        return 30
    if not math.isfinite(value) or value <= 0:
        print(f"invalid AGENT_WARDEN_INTERVAL={raw!r}; using 30", flush=True)
        return 30
    return int(value) if value.is_integer() else value


STATUS_INTERVAL = parse_status_interval(os.environ.get("AGENT_WARDEN_INTERVAL", "30"))


def scope_harm(nproc, cores):
    """A past-grace orphan is reaped only if it is heavy on one axis."""
    return nproc >= ORPHAN_PROC_MAX or cores >= ORPHAN_CPU_CORES


def _unit_rel(cgroup):
    marker = f"user@{UID}.service/"
    if marker in cgroup:
        return cgroup.split(marker, 1)[1]
    m = re.search(r"user@\d+\.service/(.*)", cgroup)
    return m.group(1) if m else ""


def _unit_parts(cgroup):
    rel = _unit_rel(cgroup).strip("/")
    if not rel:
        return None, None
    parts = rel.split("/")
    kept = []
    for part in parts:
        kept.append(part)
        if part.endswith((".service", ".scope")):
            return part, "/".join(kept)
    return None, None


def unit_of(cgroup):
    unit, _ = _unit_parts(cgroup)
    return unit


def _unit_has_own_limit(unit_path):
    d = CG_ROOT / unit_path
    for name in ("memory.max", "memory.high", "memory.swap.max"):
        v = read(d / name)
        if v is not None and v.strip() and v.strip() != "max":
            return True
    v = read(d / "cpu.max")
    if v is not None and v.strip() and not v.lstrip().startswith("max"):
        return True
    for name in ("io.max", "cpuset.cpus", "cpuset.mems"):
        v = read(d / name)
        if v is not None and v.strip():
            return True
    return False


def contained_unit(cgroup):
    unit, unit_path = _unit_parts(cgroup)
    if unit is None or unit_path is None:
        return False
    if any(fnmatch.fnmatchcase(unit, pat) for pat in JOB_UNIT_PATTERNS):
        return True
    if f"/{SLICE}/" in "/" + _unit_rel(cgroup).strip("/") + "/":
        return False
    return _unit_has_own_limit(unit_path)


