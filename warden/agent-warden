    check("agent-warden scope with the launch root gone is still an orphan", "agent-warden-305-123.scope" in units)
    check("agent-warden scope with reused root pid is still an orphan", "agent-warden-306-123.scope" in units)
    check("a live agent in a delegated child cgroup protects the whole scope",
          not orphans(child_case, manager_pids(child_case)))
    # a scope still parented by a live pane shell (no tty on the members) is attached
    held_by_live = {
        300: P(300, 40, "claude", ["claude"], O1.replace("leak", "held"), exe=f"{mise}/claude/latest/claude"),
    }
    check("scope held by a live external parent is not an orphan",
          not orphans(held_by_live, manager_pids(held_by_live)))
    check("npm storm (5140 procs, idle) is harmful by process count", scope_harm(5140, 0.0))
    check("bun server (1 proc, 0.8 core) is harmful by CPU", scope_harm(1, 0.8))
    check("quiet dev server (6 procs, 0 core) is not harmful", not scope_harm(6, 0.0))
    synthetic_st = _fixture_state()
    synthetic_tick = {"moves": [("escaped launch", _fixture_tree())], "waiting": [],
                      "orphans": [], "contained": [], "error": None, "procs": {}}
    check("status_from_tick normal validates", not status_errors(status_from_tick("report", synthetic_st, synthetic_tick,
          slice_reading=_fixture_slice(), lanes=_fixture_lanes())))
    synthetic_error_st = _fixture_state(scan_failures=1)
    synthetic_error_tick = {"moves": None, "waiting": None, "orphans": None, "contained": None, "error": "scan", "procs": {}}
    check("status_from_tick error validates", not status_errors(status_from_tick("report", synthetic_error_st, synthetic_error_tick,
          slice_reading=_fixture_slice(), lanes=_fixture_lanes())))
    for name, doc in {**status_fixture_docs(), "failed-scan": status_failed_scan_fixture()}.items():
        check(f"status {name} validates", not status_errors(doc))
    bad = status_fixture_docs()["calm"] | {"schema": "2.0"}
    check("status validator rejects an unknown schema major", bool(status_errors(bad)))
    print(f"selftest: {'PASS' if not fails else f'{fails} FAILED'}")
    return 1 if fails else 0


def main(argv):
    mode = argv[1] if len(argv) > 1 else "--report"
    if mode == "--status":
        return status()
    if mode == "--selftest":
        return selftest()
    if mode in ("--report", "--correct"):
        return run(mode == "--correct")
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
