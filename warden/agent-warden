def notify(summary, body):
    try:
        result = subprocess.run(["notify-send", "-a", "agent-warden", summary, body], timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        log(f"notify-send failed: error={type(e).__name__} summary={summary}")
        return False
    if result.returncode != 0:
        log(f"notify-send failed: exit={result.returncode} summary={summary}")
        return False
    return True


def notifier_fresh(path=NOTIFIER, now=None):
    """True when a notification consumer heartbeat is recent enough to own notices."""
    now = time.time() if now is None else now
    try:
        mtime = Path(path).stat().st_mtime
    except OSError:
        return False
    age = now - mtime
    return age < NOTIFIER_FRESH_SECONDS and age >= -NOTIFIER_FRESH_SECONDS


def deliver_notice(summary, body, consumer_fresh, sender=None):
    if consumer_fresh:
        log(f"notice left to consumer: {summary}")
        return False
    return bool((sender or notify)(summary, body))


EPISODE_KINDS = {"tasks", "memory", "not-moving", "move-failure"}


def episode_key(kind, scope):
    return f"{kind}:{scope}"


def _episodes(st):
    episodes = st.get("episodes")
    if not isinstance(episodes, dict):
        episodes = {}
    return dict(episodes)


def open_episode(st, kind, scope, now):
    if kind not in EPISODE_KINDS:
        raise ValueError(f"unknown episode kind {kind}")
    episodes = _episodes(st)
    key = episode_key(kind, scope)
    rec = episodes.get(key)
    rec = rec if isinstance(rec, dict) else None
    if rec is None or rec.get("kind") != kind or rec.get("scope") != scope:
        rec = {"kind": kind, "scope": scope, "since": now, "notified": False}
    else:
        rec = dict(rec)
        rec.setdefault("since", now)
        rec["kind"] = kind
        rec["scope"] = scope
        rec["notified"] = bool(rec.get("notified"))
    episodes[key] = rec
    st["episodes"] = episodes
    return key, rec


def clear_episodes(st, kinds, seen_keys=()):
    kinds = set(kinds)
    seen_keys = set(seen_keys)
    episodes = {
        key: value for key, value in _episodes(st).items()
        if key in seen_keys or not (isinstance(value, dict) and value.get("kind") in kinds)
    }
    st["episodes"] = episodes


def episode_delivery(st, kind, scope, consumer_fresh, now):
    key, rec = open_episode(st, kind, scope, now)
    if rec.get("notified"):
        return "none", key
    if consumer_fresh:
        return "consumer", key
    return "send", key


def mark_episode_notified(st, key):
    episodes = _episodes(st)
    rec = episodes.get(key)
    if isinstance(rec, dict):
        rec = dict(rec)
        rec["notified"] = True
        episodes[key] = rec
        st["episodes"] = episodes


def deliver_episode_notice(st, kind, scope, summary, body, consumer_fresh, now, sender=None):
    action, key = episode_delivery(st, kind, scope, consumer_fresh, now)
    if action == "consumer":
        log(f"notice left to consumer: {summary}")
        return False, key
    if action == "send":
        if (sender or notify)(summary, body):
            mark_episode_notified(st, key)
            return True, key
        return False, key
    return False, key


def record_move_result(st, summary, failures, root, reason, done, name, moved, missing, now=None):
    if done and moved:
        st["moves"] += 1
        emit_event(st, "moved", scope=name, pid=root.pid, processes=len(moved), now=now)
        summary.append(f"{root.comm} {root.pid} (+{len(moved) - 1}, {reason})")
        log(f"  moved {len(moved)} pid(s) into {SLICE}/{name} ({reason})")
    elif moved:
        st["partial"] += 1
        emit_event(st, "partial", scope=name, pid=root.pid, processes=len(moved), now=now)
        summary.append(f"PARTIAL {root.comm} {root.pid}: {len(moved)} moved, {len(missing)} not")
        log(f"  PARTIAL {name}: moved {[p.pid for p in moved]} missing {[p.pid for p in missing]}")
    elif missing:
        st["move_failures"] += 1
        emit_event(st, "failed", scope=name, pid=root.pid, processes=0, now=now)
        failures.append((f"{root.pid}:{root.start}", f"FAILED {root.comm} {root.pid}: 0 moved, {len(missing)} not"))
        log(f"  FAILED {name}: moved [] missing {[p.pid for p in missing]}")


# --- state, behind a lock -----------------------------------------------------
DEFAULT_STATE = {"skips": 0, "last_report": 0, "last_correct": 0, "moves": 0, "partial": 0,
                 "scan_failures": 0, "move_failures": 0, "reaped": 0, "orphans": {},
                 "episodes": {}, "events": [], "event_seq": 0, "near_open": [], "waiting_open": [],
                 "counters_unknown": False}
STATE_COUNTER_KEYS = ("skips", "moves", "partial", "scan_failures", "move_failures", "reaped")


def _read_status_doc():
    try:
        return json.loads(STATUS.read_text())
    except Exception:  # noqa: BLE001
        return None


def _same_major_status_doc():
    doc = _read_status_doc()
    if not isinstance(doc, dict):
        return None
    schema = doc.get("schema")
    if not isinstance(schema, str) or not re.fullmatch(r"1\.\d+", schema):
        return None
    return doc


def status_event_floor():
    doc = _same_major_status_doc()
    events = doc.get("events") if isinstance(doc, dict) else []
    if not isinstance(events, list):
        return 0
    return max((event.get("id") for event in events
                if isinstance(event, dict) and isinstance(event.get("id"), int)
                and not isinstance(event.get("id"), bool) and event.get("id") >= 0), default=0)


def published_status_counters():
    try:
        exists = STATUS.exists()
    except OSError:
        exists = True
    doc = _same_major_status_doc()
    if doc is None:
        return ("unknown" if exists else "fresh"), {}
    counters = doc.get("counters")
    if not isinstance(counters, dict):
        return "unknown", {}
    recovered = {}
    for public, internal in STATUS_COUNTER_KEYS_PUBLIC:
        value = counters.get(public)
        errors = []
        _check_int(errors, value, f"status.counters.{public}")
        if errors:
            return "unknown", {}
        recovered[internal] = value
    return "seeded", recovered


def published_status_events():
    doc = _same_major_status_doc()
    events = doc.get("events") if isinstance(doc, dict) else None
    errors = []
    _check_events(errors, events, "status.events")
    if errors:
        return []
    return list(events[-STATUS_EVENT_LIMIT:])


def default_state():
    return deepcopy(DEFAULT_STATE)


def _check_string_list(errors, value, where):
    if not isinstance(value, list) or any(not isinstance(item, str) for item in value):
        errors.append(f"{where} must be a list of strings")


def _valid_orphan_state_record(record):
    errors = []
    if not isinstance(record, dict):
        return False
    _check_number(errors, record.get("first"), "state.orphan.first")
    _check_int_or_null(errors, record.get("usage"), "state.orphan.usage")
    _check_number(errors, record.get("usage_ts"), "state.orphan.usage_ts")
    if not isinstance(record.get("harmful"), bool):
        errors.append("state.orphan.harmful must be a boolean")
    return not errors


def _valid_episode_record(key, record):
    errors = []
    if not isinstance(record, dict):
        return False
    kind = record.get("kind")
    if not isinstance(kind, str) or kind not in EPISODE_KINDS:
        errors.append("state.episode.kind must be a known string")
    scope = record.get("scope")
    if not isinstance(scope, str):
        errors.append("state.episode.scope must be a string")
    if not errors and key != episode_key(kind, scope):
        errors.append("state.episode key must match kind and scope")
    _check_number(errors, record.get("since"), "state.episode.since")
    if not isinstance(record.get("notified"), bool):
        errors.append("state.episode.notified must be a boolean")
    return not errors


def state_object(raw):
    if not isinstance(raw, dict):
        return None
    errors = []
    for key in STATE_COUNTER_KEYS:
        _check_int(errors, raw.get(key, 0), f"state.{key}")
    for key in ("last_report", "last_correct"):
        _check_number(errors, raw.get(key, 0), f"state.{key}")
    _check_int(errors, raw.get("event_seq", 0), "state.event_seq")
    _check_events(errors, raw.get("events", []), "state.events")
    _check_string_list(errors, raw.get("near_open", []), "state.near_open")
    _check_string_list(errors, raw.get("waiting_open", []), "state.waiting_open")
    if not isinstance(raw.get("counters_unknown", False), bool):
        errors.append("state.counters_unknown must be a boolean")
    raw_orphans = raw.get("orphans", {})
    raw_episodes = raw.get("episodes", {})
    if not isinstance(raw_orphans, dict):
        errors.append("state.orphans must be an object")
    if not isinstance(raw_episodes, dict):
        errors.append("state.episodes must be an object")
    if errors:
        return None
    checked = dict(raw)
    checked["orphans"] = {unit: record for unit, record in raw_orphans.items()
                            if isinstance(unit, str) and _valid_orphan_state_record(record)}
    checked["episodes"] = {key: record for key, record in raw_episodes.items()
                             if isinstance(key, str) and _valid_episode_record(key, record)}
    return checked


def state_from_text(text):
    raw = state_object(json.loads(text))
    return {**default_state(), **raw} if raw is not None else default_state()


def read_state_unlocked():
    try:
        return state_from_text(STATE.read_text())
    except FileNotFoundError:
        return default_state()
    except OSError:
        print(f"agent-warden: state=unreadable {STATE}", file=sys.stderr)
        raise
    except Exception:  # noqa: BLE001
        return default_state()


class State:
    def __init__(self, status=None):
        self.status = status

    def __enter__(self):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        self.lockfd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(self.lockfd, fcntl.LOCK_EX)
        try:
            raw = state_object(json.loads(STATE.read_text()))
            if raw is None:
                raise ValueError("invalid state")
            self.st = {**default_state(), **raw}
            self.st["_state_readable"] = True
        except Exception:  # noqa: BLE001
            missing = not STATE.exists()
            mode, recovered = published_status_counters()
            self.st = default_state()
            self.st.update(recovered)
            self.st["events"] = published_status_events()
            if mode == "seeded":
                self.st["_state_readable"] = True
            elif missing and mode == "fresh":
                self.st["_state_readable"] = True
            else:
                self.st["_state_readable"] = True
                self.st["counters_unknown"] = True
        self.st["event_seq"] = max(int(self.st.get("event_seq") or 0), status_event_floor())
        return self.st

    def __exit__(self, *exc):
        try:
            status_doc = None
            if self.status is not None:
                try:
                    tick = self.st.get("_tick") or {}
                    if tick.get("waiting_events") is not None:
                        record_waiting_events(self.st, tick.get("waiting_events") or [])
                    status_doc = status_from_tick(self.status, self.st, tick)
                except Exception as e:  # noqa: BLE001
                    log(f"status build failed: {e!r}")
            tmp = STATE_DIR / f"state.{os.getpid()}.tmp"
            stored = {k: v for k, v in self.st.items() if not k.startswith("_")}
            tmp.write_text(json.dumps(stored))
            os.replace(tmp, STATE)
            if status_doc is not None:
                try:
                    write_status(status_doc)
                except Exception as e:  # noqa: BLE001
                    log(f"status write failed: {e!r}")
        finally:
            fcntl.flock(self.lockfd, fcntl.LOCK_UN)
            os.close(self.lockfd)


def only_pids():
    v = os.environ.get("AGENT_WARDEN_ONLY")
    return {int(x) for x in v.split(",") if x.strip()} if v else None


def run(correct):
    tick_now = time.time()
    consumer_fresh = notifier_fresh(now=tick_now)
    only = only_pids()
    with State(status=None if only is not None else ("correct" if correct else "report")) as st:
        st["_tick"] = {"procs": None, "moves": [], "waiting": [], "waiting_events": None,
                       "orphans": [], "contained": [], "error": None, "fresh_labels": False}
        summary = []  # moved-tree notices; without this the first move raised NameError
        failures = []
        seen_near = set()
        seen_move_conditions = set()
        move_conditions_evaluated = False
        try:
            procs = scan()
            moves, unmatched, held, units = plan(procs, only)
        except Exception as e:  # noqa: BLE001
            st["scan_failures"] += 1
            st["_tick"].update({"moves": None, "waiting": None, "orphans": None,
                                "contained": None, "error": "scan"})
            log(f"scan failed: {e!r}")
            return 1
        st["_tick"].update({"procs": procs, "moves": moves, "contained": units})
        st["last_correct" if correct else "last_report"] = tick_now
        for p in unmatched:
            log(f"unmatched build process, nearest marker above is not an agent: {p.describe()}")
        for p in held:
            log(f"shared scope: session {p.describe()} shares its parent's scope; not split "
                f"({'capped lineage' if lineage_is_capped(p.cgroup) else 'AGENT_WARDEN_SPLIT_SESSIONS=0'})")
        unit_counts = {}
        for p in units:
            unit = unit_of(p.cgroup) or "unknown"
            unit_counts[unit] = unit_counts.get(unit, 0) + 1
        for unit, count in sorted(unit_counts.items()):
            log(f"job unit {unit}: {count} process(es) carry their own containment; left in place")
        if only is None:
            try:
                enforce_task_caps(correct)
                near, unknown_near, near_complete = warn_near_cap()
                record_near_events(st, near, unknown_near, near_complete, now=tick_now)
                for unit, kind, human in near:
                    log(f"scope {unit} near its {kind} ceiling: {human}")
                    sent, key = deliver_episode_notice(
                        st, kind, unit,
                        f"agent-warden: a lane is near its {kind} ceiling",
                        f"{unit}: {human}. A big legit build (raise the ceiling) "
                        f"or a runaway starting.",
                        consumer_fresh, tick_now)
                    seen_near.add(key)
                for unit, kind in sorted(unknown_near):
                    log(f"near-cap unreadable: scope={unit} kind={kind}")
                    seen_near.add(episode_key(kind, unit))
                if not near_complete:
                    log("near-cap unreadable: scope-list")
                    for key, rec in _episodes(st).items():
                        if isinstance(rec, dict) and rec.get("kind") in {"tasks", "memory"}:
                            seen_near.add(key)
                clear_episodes(st, {"tasks", "memory"}, seen_near)
            except Exception as e:  # noqa: BLE001
                log(f"task-cap enforcement raised {e!r}")
        try:
            reaped, orphan_rows = reap_orphans(procs, st, correct, only)
            st["_tick"]["orphans"] = orphan_rows
        except Exception as e:  # noqa: BLE001
            reaped = []
            st["_tick"]["orphans"] = None
            log(f"orphan reap raised {e!r}")
        if reaped:
            deliver_notice(f"agent-warden: reaped {len(reaped)} orphan scope(s)", "\n".join(reaped[:6])
                           + ("\n..." if len(reaped) > 6 else ""), consumer_fresh)
        if not moves:
            st["skips"] = 0
            if correct:
                st["_tick"]["waiting_events"] = []
            if correct and only is None:
                clear_episodes(st, {"not-moving", "move-failure"})
            return 0
        for reason, tree in moves:
            log(f"{reason}: root {tree[0].describe()} (+{len(tree) - 1} descendants)")
        if not correct:
            log(f"report mode: {len(moves)} tree(s) would move")
            return 0
        try:
            bus = Bus()
        except OSError as e:
            st["move_failures"] += 1
            emit_event(st, "failed")
            log(f"cannot reach the user bus: {e}")
            return 1
        waiting = []
        move_conditions_evaluated = True
        try:
            for reason, tree in moves:
                ok, cur, mx = headroom()
                root_scope = f"{tree[0].pid}:{tree[0].start}"
                if not ok:
                    st["skips"] += 1
                    waiting.append((reason, tree))
                    st["_tick"]["waiting"] = waiting
                    seen_move_conditions.add(episode_key("move-failure", root_scope))
                    seen_move_conditions.add(episode_key("not-moving", SLICE))
                    open_episode(st, "not-moving", SLICE, tick_now)
                    where = "unreadable" if cur < 0 else f"{cur >> 30} GiB of {mx >> 30} GiB"
                    log(f"headroom {where}: NOT moving {tree[0].comm} pid {tree[0].pid} (skip {st['skips']})")
                    if st["skips"] >= 3:
                        sent, key = deliver_episode_notice(
                            st, "not-moving", SLICE, "agent-warden: not moving",
                            f"{tree[0].comm} pid {tree[0].pid} waits; {SLICE} headroom {where}",
                            consumer_fresh, tick_now)
                        seen_move_conditions.add(key)
                    continue
                st["skips"] = 0
                try:
                    done, name, moved, missing = move(tree, reason, bus)
                except Exception as e:  # noqa: BLE001
                    st["move_failures"] += 1
                    emit_event(st, "failed", scope=warden_scope_name(tree[0], reason), pid=tree[0].pid, processes=None)
                    failures.append((root_scope, f"FAILED {tree[0].comm} {tree[0].pid}: move raised {e!r}"))
                    log(f"  move of pid {tree[0].pid} raised {e!r}")
                    continue
                record_move_result(st, summary, failures, tree[0], reason, done, name, moved, missing)
                if moved:
                    st["_tick"]["fresh_labels"] = True
        finally:
            bus.close()
        st["_tick"]["waiting_events"] = waiting
        if summary:
            deliver_notice(f"agent-warden: {len(summary)} move(s) into agents.slice",
                           "\n".join(summary[:6]) + ("\n..." if len(summary) > 6 else ""), consumer_fresh)
        failure_notice_lines = []
        failure_notice_keys = []
        failure_left_to_consumer = False
        for scope, line in failures:
            action, key = episode_delivery(st, "move-failure", scope, consumer_fresh, tick_now)
            seen_move_conditions.add(key)
            if action == "send":
                failure_notice_lines.append(line)
                failure_notice_keys.append(key)
            elif action == "consumer":
                failure_left_to_consumer = True
        if failure_notice_lines:
            if notify(f"agent-warden: {len(failure_notice_lines)} move failure(s)",
                      "\n".join(failure_notice_lines[:6]) + ("\n..." if len(failure_notice_lines) > 6 else "")):
                for key in failure_notice_keys:
                    mark_episode_notified(st, key)
        elif failure_left_to_consumer:
            log("notice left to consumer: agent-warden: move failure(s)")
        if move_conditions_evaluated and only is None:
            clear_episodes(st, {"not-moving", "move-failure"}, seen_move_conditions)
    return 0

def status():
    try:
        st = read_state_unlocked()
    except OSError:
        return 1
    procs = scan()
    moves, unmatched, held, units = plan(procs)
    pending = {p.pid for _, t in moves for p in t}
    unitp = {p.pid for p in units}
    now = time.time()

    def age(k):
        return "never" if not st.get(k) else f"{int(now - st[k])} s ago"

    print(f"last correct scan {age('last_correct')}, last report scan {age('last_report')}; "
          f"moves {st['moves']}, partial {st['partial']}, reaped {st.get('reaped', 0)}, "
          f"move failures {st['move_failures']}, scan failures {st['scan_failures']}, "
          f"consecutive skips {st['skips']}")
    print("notifier heartbeat " + ("fresh" if notifier_fresh(now=now) else "stale"))
    episodes = _episodes(st)
    if episodes:
        print(f"open episodes {len(episodes)}")
        for rec in sorted(episodes.values(), key=lambda item: (str(item.get("kind")), str(item.get("scope")))):
            since = rec.get("since")
            waited = f", open {int(now - since)}s" if isinstance(since, (int, float)) else ""
            notified = "notified" if rec.get("notified") else "pending"
            print(f"  EPISODE {rec.get('kind')} {rec.get('scope')}: {notified}{waited}")
    for unit, pids in orphans(procs, manager_pids(procs)):
        rec = (st.get("orphans") or {}).get(unit); rec = rec if isinstance(rec, dict) else {}
        first = rec.get("first")
        waited = f"{int(now - first)}s" if first else "new this scan"
        n = len(pids)
        gate = "harmful" if n >= ORPHAN_PROC_MAX else f"reaped when >= {ORPHAN_PROC_MAX} procs or >= {ORPHAN_CPU_CORES} cores"
        print(f"  ORPHAN {unit}: {n} process(es), launcher gone, {waited}; {gate}")
    ok, cur, mx = headroom()
    print(f"{SLICE} memory: " + ("unreadable" if cur < 0 else f"{cur >> 30} GiB of {mx >> 30 if mx else 'unlimited'}"
                                   + ("" if ok else "  (above headroom)")))
    print(f"{'pid':>8} {'state':9} {'comm':14} {'env':6} cgroup")
    heldp = {p.pid for p in held}
    for p in sorted(procs.values(), key=lambda x: (not x.is_agent, x.pid)):
        if not (p.is_agent or p.pid in pending or p.pid in unitp or (p.is_build and has_agent_or_tmux_above(procs, p))):
            continue
        env = (read(f"/proc/{p.pid}/environ", "") or "").split("\0")
        marks = ("A" if p.marked else "") + "".join(l for m, l in zip(ENV_MARKERS, "JCRL") if any(e.startswith(m + "=") for e in env))
        state = ("unit" if p.pid in unitp else "held" if p.pid in heldp else "pending" if p.pid in pending
                 else "ok" if p.confined else "OUTSIDE")
        print(f"{p.pid:>8} {state:9} {p.comm[:14]:14} {marks or '-':6} {p.short_cg()}")
    for p in unmatched:
        print(f"{p.pid:>8} {'unmatched':9} {p.comm[:14]:14} {'-':5} {p.short_cg()}  (nearest marker not an agent)")
    print("env: A=launched through agent-confine J=MAKEFLAGS(jobserver) C=CARGO_BUILD_JOBS R=RUST_TEST_THREADS L=MOLD_JOBS; "
          "held = session sharing a capped lineage, left alone")
    return 0


