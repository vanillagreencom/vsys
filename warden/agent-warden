def read(path, default=None):
    try:
        return Path(path).read_bytes().decode("utf-8", "replace")
    except OSError:
        return default


def exe_path(link):
    """A binary a package update replaced while it ran reads "<path> (deleted)"."""
    return link.removesuffix(" (deleted)")


class Proc:
    __slots__ = ("pid", "ppid", "comm", "argv", "exe", "cgroup", "start", "uid", "tty", "_marked")

    def __init__(self, pid, *, ppid=None, comm=None, argv=None, exe="", cgroup=None,
                 start=0, uid=None, marked=False, tty=0):
        self.pid = pid
        self._marked = None
        if comm is not None:  # injected record
            self.ppid, self.comm, self.argv, self.exe = ppid, comm, list(argv or []), exe_path(exe)
            self.cgroup, self.start, self.uid = cgroup, start, UID if uid is None else uid
            self.tty = tty
            self._marked = marked
            return
        stat = read(f"/proc/{pid}/stat")
        if not stat:
            raise OSError
        head, _, tail = stat.rpartition(")")
        self.comm = head.split("(", 1)[1]
        fields = tail.split()
        self.ppid = int(fields[1])
        self.tty = int(fields[4])   # tty_nr; 0 = no controlling terminal
        self.start = int(fields[19])
        m = re.search(r"^Uid:\s+(\d+)", read(f"/proc/{pid}/status", ""), re.M)
        self.uid = int(m.group(1)) if m else -1
        raw = read(f"/proc/{pid}/cmdline", "")
        self.argv = [a for a in raw.split("\0") if a] if raw else []
        try:
            self.exe = exe_path(os.readlink(f"/proc/{pid}/exe"))
        except OSError:
            self.exe = ""
        cg = (read(f"/proc/{pid}/cgroup", "") or "").strip()
        self.cgroup = cg.split("::", 1)[1] if "::" in cg else cg

    @property
    def confined(self):
        return f"/{SLICE}/" in self.cgroup + "/"

    @property
    def marked(self):
        """launched through agent-confine (or descended from such a launch)"""
        if self._marked is None:
            env = read(f"/proc/{self.pid}/environ", "") or ""
            self._marked = "\0AGENT_CONFINE=1\0" in "\0" + env
        return self._marked

    @property
    def exe_name(self):
        return os.path.basename(self.exe) if self.exe else self.comm

    @property
    def program(self):
        if self.comm in HOST_COMMS and len(self.argv) > 1 and not self.argv[1].startswith("-"):
            return os.path.basename(self.argv[1])
        return os.path.basename(self.argv[0]) if self.argv else self.comm

    @property
    def flags(self):
        """option tokens: after argv[0], before the first `--`"""
        out = []
        for a in self.argv[1:]:
            if a == "--":
                break
            if a.startswith("-"):
                out.append(a)
        return out

    @property
    def excluded(self):
        if any(f in EXCLUDE_FLAGS for f in self.flags):
            return True
        if self.program in EXCLUDE_PROGRAMS:
            return True
        return bool(self.argv) and os.path.basename(self.argv[0]) in EXCLUDE_PROGRAMS

    @property
    def is_desktop(self):
        if self.comm in DESKTOP_COMMS:
            return True
        if any(a.startswith(CHROMIUM_CHILD_FLAG) for a in self.argv[1:]):
            return True  # zygote, gpu-process, renderer, utility
        if "/claude-desktop/" in self.exe or "/Claude" in self.exe:
            return True
        if self.exe.startswith(DESKTOP_EXE_PREFIXES):
            return not (self.exe.endswith(BUNDLED_CLI_SUFFIXES) or self.exe_name in HELPER_NAMES)
        return False

    def _confirmed_by_location(self, name):
        """D010: a name matches only where the tool's own install locations
        confirm it, each as a path-prefix or exact match against the
        process's own resolved executable, never a bare substring or suffix
        a same-uid process could reproduce under any writable directory it
        chooses. A reader's own name with no location is trusted as-is, and
        an unreadable executable never hides an escaped agent."""
        location = TOOL_LOCATIONS.get(name)
        if not location or not (location["mise"] or location["executables"]):
            return True
        if not self.exe:
            return True
        if any(self.exe.startswith(f"{MISE_DATA}/installs/{directory}/") for directory in location["mise"]):
            return True
        if self.exe in location["executables"]:
            return True
        return self.exe.startswith(DESKTOP_EXE_PREFIXES) and self.exe.endswith(BUNDLED_CLI_SUFFIXES)

    @property
    def is_agent(self):
        if self.excluded or self.is_desktop:
            return False
        if self.comm in AGENT_COMMS:
            return self._confirmed_by_location(self.comm)
        return self.comm in HOST_COMMS and any(AGENT_PATH_RE.search(a) for a in self.argv[:2])

    @property
    def is_build(self):
        if self.excluded or self.is_desktop:
            return False
        if self.comm in BUILD_COMMS:
            return True
        return self.comm in HOST_COMMS and len(self.argv) > 1 and bool(BUILD_SCRIPT_RE.search(self.argv[1]))

    @property
    def rides_along(self):
        if self.excluded or self.is_desktop:
            return False
        if self.is_build or self.comm in SHELL_COMMS or self.exe_name in HELPER_NAMES or self.marked:
            return True
        return bool(self.exe) and self.exe.startswith(TOOLCHAIN_PREFIXES)

    def short_cg(self):
        return self.cgroup.split(f"user@{UID}.service/", 1)[-1]

    def describe(self):
        return f"pid {self.pid} {self.comm} [{self.short_cg()}] {' '.join(self.argv)[:70]}"


# --- process tree -----------------------------------------------------------
def scan():
    procs = {}
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        try:
            p = Proc(int(entry.name))
        except (OSError, IndexError, ValueError):
            continue
        if p.uid == UID:
            procs[p.pid] = p
    return procs


def index(procs):
    children = {}
    for p in procs.values():
        children.setdefault(p.ppid, []).append(p.pid)
    return children


def ancestors(procs, pid):
    seen = set()
    while pid in procs and pid not in seen:
        seen.add(pid)
        pid = procs[pid].ppid
        if pid in procs:
            yield procs[pid]


def depth(procs, p):
    return sum(1 for _ in ancestors(procs, p.pid))


def nearest_marker(procs, p):
    return next((a for a in ancestors(procs, p.pid)
                 if a.is_agent or a.comm == TMUX_COMM or a.is_desktop or a.excluded), None)


def has_agent_or_tmux_above(procs, p):
    m = nearest_marker(procs, p)
    return m is not None and (m.is_agent or m.comm == TMUX_COMM)


def subtree(procs, children, root, stop):
    out = [root]
    stack = list(children.get(root.pid, []))
    while stack:
        pid = stack.pop()
        p = procs.get(pid)
        if p is None or stop(p):
            continue
        out.append(p)
        stack.extend(children.get(pid, []))
    return out


def manager_pids(procs):
    """PIDs that adopt a reparented process: init (1) and the user's
    `systemd --user` manager. A member whose parent is one of these has lost the
    process that launched it."""
    out = {0, 1}
    for p in procs.values():
        if p.comm == "systemd" and any("--user" in a for a in p.argv):
            out.add(p.pid)
    return out


def scope_members(procs):
    """Group every agents.slice process by its top-level scope unit, INCLUDING
    processes in delegated child cgroups under that scope (a live agent can sit
    in `<scope>/child`; missing it would let the reaper stop the scope out from
    under it)."""
    by_scope = {}
    for p in procs.values():
        m = SCOPE_RE.search(p.cgroup or "")
        if m:
            by_scope.setdefault(m.group(1), []).append(p)
    return by_scope


def launch_root_alive(unit, members):
    """True when a scope still contains the non-build process its name identifies."""
    m = re.fullmatch(r"agent-confine-(\d+)-[^/]+\.scope", unit or "")
    needs_start = False
    if m is None:
        m = re.fullmatch(r"agent-warden-(\d+)-(\d+)\.scope", unit or "")
        needs_start = True
    if m is None:
        return False
    root_pid = int(m.group(1))
    pids = {p.pid for p in members}
    root = next((p for p in members if p.pid == root_pid), None)
    if root is None or root.ppid in pids:
        return False
    return not needs_start or root.start == int(m.group(2))


def _is_orphan(unit, members, managers):
    """True when a scope's whole membership is abandoned leftover work: no member
    holds a controlling terminal, no member is itself a live agent session, and
    every member is either parented inside the scope or was reparented to
    init/the manager. A live agent (even headless, even with its launch shell
    gone) is never junk to reap; nor is a scope still held by a live external
    process (a pane shell, another subreaper). A still-running launch root in an
    agent-confine and non-build agent-warden scopes also protect unlisted agent CLIs. Only leftover
    non-agent processes (dev servers, npm/bun, a stuck build) qualify."""
    if not members or any(p.tty for p in members):
        return False
    if any(p.is_agent for p in members):
        return False                 # a live agent session, headless or not
    if launch_root_alive(unit, members):
        return False
    pids = {p.pid for p in members}
    reparented = False
    for p in members:
        if p.ppid in pids:
            continue                 # parent is inside the scope subtree
        if p.ppid in managers:
            reparented = True        # its launcher is gone
        else:
            return False             # a live external process still holds it
    return reparented


def orphans(procs, managers):
    """(scope_unit, [pids]) for every fully-orphaned agents.slice scope."""
    return [(unit, sorted(p.pid for p in members))
            for unit, members in scope_members(procs).items()
            if _is_orphan(unit, members, managers)]


def _scope_procfiles(base):
    try:
        return [base / "cgroup.procs", *base.glob("**/cgroup.procs")]
    except OSError as e:
        log(f"orphan recheck incomplete: cannot enumerate {base}: {e}")
        return None


def scope_still_orphan(unit, managers):
    """Re-read one scope's live membership straight from the cgroup tree and
    re-test it, immediately before stopping. Guards against a scope that gained
    an attached process, or was recreated under the same name, between the scan
    and the stop."""
    base = CG_ROOT / SLICE / unit
    if not base.is_dir():
        return False
    procfiles = _scope_procfiles(base)
    if procfiles is None:
        return False
    members = []
    for procfile in procfiles:
        txt = read(procfile)
        if txt is None:
            if procfile.parent.exists():
                log(f"orphan recheck incomplete: cannot read {procfile}")
                return False
            continue
        for line in txt.split():
            try:
                pid = int(line)
            except ValueError:
                continue
            try:
                members.append(Proc(pid))
            except (OSError, IndexError, ValueError):
                # a live member we cannot read is unknown, not absent: refuse to
                # reap on a partial view (it could be an attached process the
                # safety check would otherwise miss). A pid that simply vanished
                # is fine to skip.
                if os.path.exists(f"/proc/{pid}"):
                    return False
    return bool(members) and _is_orphan(unit, members, managers)


def scope_units():
    """Every scope unit directly under agents.slice, with its pids.max."""
    out = {}
    base = CG_ROOT / SLICE
    try:
        for d in base.iterdir():
            if d.is_dir() and d.name.endswith(".scope"):
                out[d.name] = (read(d / "pids.max", "") or "").strip()
    except OSError:
        pass
    return out


def slice_tasks_max():
    """The agents.slice task ceiling (the whole-slice cap), or a safe default."""
    v = (read(CG_ROOT / SLICE / "pids.max", "") or "").strip()
    try:
        return int(v)
    except ValueError:
        return 16384


def enforce_task_caps(correct):
    """Cap any agents.slice scope left UNBOUNDED (TasksMax `max`, or at/above the
    whole-slice ceiling, i.e. one scope free to consume the entire slice). Covers
    a scope created without the cap: a shadowed launcher, a raw systemd-run, one
    predating the cap. A scope with any smaller explicit cap, or a deliberate
    larger one still below the slice ceiling, is left alone, so an
    AGENT_SCOPE_TASKS_MAX override survives. agent-confine sets the cap at
    creation, so this is a backstop: a fast storm from an uncapped scope can
    still fill the slice inside one 30 s tick. Returns the units capped."""
    ceiling = slice_tasks_max()
    capped = []
    for unit, cur in scope_units().items():
        try:
            unbounded = cur == "max" or int(cur) >= ceiling
        except ValueError:
            unbounded = True
        if not unbounded:
            continue
        if not correct:
            log(f"scope {unit}: TasksMax {cur} is unbounded (>= slice {ceiling}); would cap (report mode)")
            continue
        r = subprocess.run(["systemctl", "--user", "set-property", "--runtime", unit,
                           f"TasksMax={SCOPE_TASKS_MAX}"], capture_output=True, text=True, timeout=15)
        if r.returncode == 0:
            capped.append(unit)
            log(f"  capped {unit} TasksMax {cur} -> {SCOPE_TASKS_MAX} (was unbounded)")
        else:
            log(f"  cap of {unit} failed: {(r.stderr or '').strip()}")
    return capped


def warn_near_cap():
    """A lane climbing toward its own task or memory ceiling: either a legit
    workload bigger than expected (raise the ceiling) or a runaway starting
    (intervene). Surfaced so a real workload is seen before a ceiling could ever
    limit it. Returns (near, unknown, complete) where near is [(unit, kind,
    human)], unknown is {(unit, kind)} for unreadable metrics, and complete says
    the scope list itself was read."""
    near, unknown = [], set()
    base = CG_ROOT / SLICE
    if not base.is_dir():
        return near, unknown, True
    try:
        entries = list(base.iterdir())
    except OSError:
        return near, unknown, False
    for d in entries:
        if not (d.is_dir() and d.name.endswith(".scope")):
            continue
        txt = read(d / "pids.current")
        try:
            n = int((txt or "").strip())
        except ValueError:
            unknown.add((d.name, "tasks"))
        else:
            if n >= SCOPE_TASKS_WARN:
                near.append((d.name, "tasks", f"{n} of {(read(d / 'pids.max', '') or '').strip()}"))
        txt = read(d / "memory.current")
        try:
            mem = int((txt or "").strip())
        except ValueError:
            unknown.add((d.name, "memory"))
        else:
            if mem >= SCOPE_MEM_WARN:
                near.append((d.name, "memory", f"{mem >> 30} GiB (soft cap {SCOPE_MEM_HIGH >> 30})"))
    return near, unknown, True


def reap(unit):
    """Stop one orphaned scope. systemd kills its members and removes the unit.
    Precise (one unit by exact name), so it never touches another session."""
    r = subprocess.run(["systemctl", "--user", "stop", unit],
                       capture_output=True, text=True, timeout=15)
    return r.returncode == 0, (r.stderr or "").strip()


def scope_usage_usec(unit):
    """Total CPU microseconds the scope has used, from its cpu.stat, or None."""
    txt = read(CG_ROOT / SLICE / unit / "cpu.stat")
    if not txt:
        return None
    m = re.search(r"^usage_usec\s+(\d+)", txt, re.M)
    return int(m.group(1)) if m else None


def reap_orphans(procs, st, correct, only=None):
    """Carry orphaned scopes across ticks; reap those that stay orphaned past the
    grace period AND are harmful (many processes or steady CPU) on two ticks in a
    row. CPU is measured across ticks from cpu.stat, so nothing is stopped on its
    first sighting, and a one-tick spike in an otherwise idle server never trips
    it. A quiet abandoned server is reported and left running. Membership is
    re-read from the cgroup right before a stop. Restricted runs
    (AGENT_WARDEN_ONLY) never reap. Returns the units reaped."""
    managers = manager_pids(procs)
    seen = dict(orphans(procs, managers))
    prev = st.get("orphans") or {}
    now = time.time()
    tracked, reaped, status_rows = {}, [], []
    for unit, pids in seen.items():
        p = prev.get(unit)
        p = p if isinstance(p, dict) else {}
        first = p.get("first", now)
        n = len(pids)
        usage = scope_usage_usec(unit)
        cores = None
        prev_usage, prev_ts = p.get("usage"), p.get("usage_ts")
        if usage is not None and prev_usage is not None and prev_ts and now > prev_ts:
            cores = max(0.0, (usage - prev_usage) / 1e6 / (now - prev_ts))
        age = now - first
        harmful = age >= ORPHAN_GRACE and scope_harm(n, 0.0 if cores is None else cores)
        # reap only when harmful on this tick and the one before it
        do_reap = harmful and p.get("harmful", False)
        entry = {"first": first, "usage": usage, "usage_ts": now, "harmful": harmful}
        tracked[unit] = entry
        status_row = {"scope": unit, "processes": n, "cores": cores, "since": first, "harmful": harmful}
        display_cores = 0.0 if cores is None else cores
        if age < ORPHAN_GRACE:
            status_rows.append(status_row)
            log(f"orphan scope {unit}: {n} process(es), launcher gone, {int(age)}s "
                f"of {int(ORPHAN_GRACE)}s grace; watching")
            continue
        if not harmful:
            status_rows.append(status_row)
            log(f"orphan scope {unit}: {n} process(es), {display_cores:.1f} core(s), idle "
                f"and abandoned {int(age)}s; watching, not reaping")
            continue
        why = f"{n} process(es)" if n >= ORPHAN_PROC_MAX else f"{display_cores:.1f} core(s)"
        if not do_reap:
            status_rows.append(status_row)
            log(f"orphan scope {unit}: harmful ({why}) for the first tick; reaping on the next if it holds")
            continue
        if only is not None:
            status_rows.append(status_row)
            log(f"orphan scope {unit}: harmful ({why}) but AGENT_WARDEN_ONLY is set; not reaping")
            continue
        if not (correct and REAP):
            status_rows.append(status_row)
            log(f"orphan scope {unit}: harmful ({why}), abandoned {int(age)}s"
                + (" (report mode, not reaping)" if not correct else " (REAP disabled)"))
            continue
        if not scope_still_orphan(unit, managers):
            log(f"orphan scope {unit}: no longer orphaned on recheck; not reaping")
            tracked.pop(unit, None)
            continue
        ok, err = reap(unit)
        if ok:
            st["reaped"] += 1
            emit_event(st, "reaped", scope=unit, processes=n)
            reaped.append(f"{unit} ({why})")
            log(f"  reaped orphan scope {unit}: stopped {n} process(es), {why}, after {int(age)}s")
            tracked.pop(unit, None)
        else:
            st["move_failures"] += 1
            status_rows.append(status_row)
            log(f"  reap of {unit} failed: {err}")
    st["orphans"] = tracked
    return reaped, status_rows

def _limit(v):
    v = (v or "").strip()
    return float("inf") if v == "max" else int(v)


def lineage_is_capped(cgroup):
    """True when any cgroup from the process's own up to (excluding) agents.slice
    carries a limit tighter than normal (systemd gives every scope a pids.max of
    DefaultTasksMax, which is wider than the slice's, not a cap). "Normal" for
    pids.max and memory.high is the standard per-scope cap: every scope now
    carries it, so it is the baseline, not a deliberate extra limit. Only a
    pids.max or memory.high below that baseline, or a memory/cpu/io/cpuset
    limit tighter than the slice, marks a scope the owner limited on purpose
    (a GPU run, a nested launch that asked for less), which is never split and
    never left."""
    rel = cgroup.split(f"user@{UID}.service/", 1)[-1]
    parts = rel.split("/")
    if not parts or parts[0] != SLICE:
        return True
    baseline = {}
    for name, _ in CAP_FILES:
        v = read(CG_ROOT / SLICE / name)
        if v is None:
            return True
        baseline[name] = _limit(v)
    baseline["pids.max"] = min(baseline["pids.max"], SCOPE_TASKS_MAX)
    baseline["memory.high"] = min(baseline["memory.high"], SCOPE_MEM_HIGH)
    for i in range(len(parts), 1, -1):
        d = CG_ROOT / "/".join(parts[:i])
        for name, _ in CAP_FILES:
            v = read(d / name)
            if v is None or _limit(v) < baseline[name]:
                return True
        v = read(d / "cpu.max")
        if v is None or not v.startswith("max"):
            return True
        for name in ("io.max", "cpuset.cpus", "cpuset.mems"):
            v = read(d / name)
            if v is not None and v.strip():
                return True
    return False


def plan(procs, only=None, capped=lineage_is_capped, split=None, contained=contained_unit):
    """Return (moves, unmatched, held, units). moves: (reason, [Proc...]) with [0] the root."""
    children = index(procs)
    moves, unmatched, held, units = [], [], [], []
    claimed = set()
    if split is None:
        split = os.environ.get("AGENT_WARDEN_SPLIT_SESSIONS", "1") != "0"

    def allowed(p):
        return only is None or p.pid in only

    def is_contained(p):
        return contained(p.cgroup)

    def stop_default(p):
        return (p.confined or p.excluded or p.is_agent or is_contained(p)
                or not p.rides_along or not allowed(p))

    def desktop_owned(p):
        m = nearest_marker(procs, p)
        return m is not None and (m.is_desktop or m.excluded)

    def note_unit(p):
        if p.pid in claimed or p.confined or p.excluded or p.is_desktop:
            return
        if p.marked and (p.is_agent or not desktop_owned(p)):
            units.append(p)
        elif p.is_agent:
            units.append(p)
        elif p.is_build and has_agent_or_tmux_above(procs, p):
            units.append(p)

    for p in procs.values():
        if allowed(p) and is_contained(p):
            note_unit(p)

    def take(reason, tree):
        tree = [p for p in tree if p.pid not in claimed]
        if tree:
            moves.append((reason, tree))
            claimed.update(p.pid for p in tree)

    # 1. escaped launches: marked and outside the slice; root = topmost such.
    #    A marked non-agent (a shell, a build) stays when the nearest marker
    #    above it is a desktop app or an excluded helper; an agent CLI a
    #    desktop app started is still its own session.
    escaped = [p for p in procs.values() if allowed(p) and not p.confined and p.marked
               and not is_contained(p) and not p.is_desktop and not p.excluded
               and (p.is_agent or not desktop_owned(p))]
    for p in sorted(escaped, key=lambda x: (depth(procs, x), x.pid)):
        if p.pid not in claimed:
            take("escaped launch", subtree(procs, children, p, stop_default))

    # 2. unmarked agents outside the slice (a CLI a desktop app started)
    unconf_agents = [p for p in procs.values() if allowed(p) and not p.confined and not is_contained(p)
                     and p.is_agent and p.pid not in claimed]
    unconf_builds = []
    for p in procs.values():
        if not allowed(p) or p.confined or is_contained(p) or not p.is_build or p.pid in claimed:
            continue
        if has_agent_or_tmux_above(procs, p):
            unconf_builds.append(p)
        else:
            unmatched.append(p)

    # shallowest first, so a parent's tree claims its descendants before they
    # are considered as roots of their own (pid order is not ancestry order)
    for p in sorted(unconf_agents, key=lambda x: (depth(procs, x), x.pid)):
        if p.pid not in claimed:
            take("unconfined agent", subtree(procs, children, p, stop_default))
    for p in sorted(unconf_builds, key=lambda x: (depth(procs, x), x.pid)):
        if p.pid not in claimed:
            take("unconfined build", subtree(procs, children, p, stop_default))

    # 3. sessions sharing a scope. The earliest-started agent in a cgroup is
    #    its owner; every other agent in that cgroup is another session and
    #    gets its own scope. Ancestry is not required: a headless worker may be
    #    reparented after its spawning shell exits (codex exec, `claude -p &`).
    by_cg = {}
    for p in procs.values():
        if p.is_agent and p.confined and not is_contained(p):
            by_cg.setdefault(p.cgroup, []).append(p)
    for cg, members in by_cg.items():
        if len(members) < 2:
            continue
        owner = min(members, key=lambda x: (x.start, x.pid))
        for p in sorted(members, key=lambda x: (x.start, x.pid)):
            if p is owner or not allowed(p) or p.pid in claimed:
                continue
            if not split or capped(cg):
                held.append(p)
                continue
            take("nested session", subtree(procs, children, p,
                                           lambda x: x.excluded or x.is_agent or x.cgroup != cg
                                           or contained(x.cgroup) or not x.rides_along or not allowed(x)))
    return moves, unmatched, held, units


# --- moving -------------------------------------------------------------------
def headroom():
    slice_dir = CG_ROOT / SLICE
    if not slice_dir.is_dir():
        return True, 0, 0
    cur = read(slice_dir / "memory.current")
    mx = read(slice_dir / "memory.max")
    if cur is None or mx is None:
        return False, -1, -1
    cur, mx = cur.strip(), mx.strip()
    try:
        current = int(cur)
        if mx == "max":
            return True, current, 0
        maximum = int(mx)
    except ValueError:
        return False, -1, -1
    return current < HEADROOM * maximum, current, maximum


def recheck(p, nested):
    """fresh Proc + pidfd when identity, cgroup and classification still hold, else None"""
    try:
        fd = os.pidfd_open(p.pid)
    except OSError:
        return None
    try:
        q = Proc(p.pid)
    except (OSError, IndexError, ValueError):
        os.close(fd)
        return None
    bad = (q.start != p.start or q.cgroup != p.cgroup or q.excluded or q.is_desktop
           or (p.is_agent and not q.is_agent) or (p.is_build and not q.is_build)
           or not (q.is_agent or q.is_build or q.rides_along)
           or contained_unit(q.cgroup) or (nested and lineage_is_capped(q.cgroup)))
    if bad:
        os.close(fd)
        return None
    return q, fd


class Bus:
    """StartTransientUnit with PIDFDs through libsystemd; identity travels with the fd."""

    class Error(ctypes.Structure):
        _fields_ = [("name", ctypes.c_char_p), ("message", ctypes.c_char_p), ("need_free", ctypes.c_int)]

    def __init__(self):
        self.lib = ctypes.CDLL("libsystemd.so.0")
        self.bus = ctypes.c_void_p()
        if self.lib.sd_bus_default_user(ctypes.byref(self.bus)) < 0:
            raise OSError("no user bus")

    def start_scope(self, name, fds):
        lib, m, reply, err = self.lib, ctypes.c_void_p(), ctypes.c_void_p(), self.Error()
        c = ctypes.c_char_p
        if lib.sd_bus_message_new_method_call(self.bus, ctypes.byref(m), b"org.freedesktop.systemd1",
                                              b"/org/freedesktop/systemd1",
                                              b"org.freedesktop.systemd1.Manager", b"StartTransientUnit") < 0:
            raise OSError("message")
        ok = lib.sd_bus_message_append(m, b"ss", c(name.encode()), c(b"fail")) >= 0
        ok &= lib.sd_bus_message_open_container(m, ctypes.c_char(b"a"), b"(sv)") >= 0
        ok &= lib.sd_bus_message_append(m, b"(sv)", c(b"PIDFDs"), c(b"ah"), ctypes.c_int(len(fds)),
                                        *[ctypes.c_int(fd) for fd in fds]) >= 0
        ok &= lib.sd_bus_message_append(m, b"(sv)", c(b"Slice"), c(b"s"), c(SLICE.encode())) >= 0
        ok &= lib.sd_bus_message_append(m, b"(sv)", c(b"Delegate"), c(b"b"), ctypes.c_int(1)) >= 0
        # A non-default weight enables the CPU controller inside agents.slice; 100 was measured not to.
        ok &= lib.sd_bus_message_append(m, b"(sv)", c(b"CPUWeight"), c(b"t"), ctypes.c_uint64(SCOPE_CPU_WEIGHT)) >= 0
        ok &= lib.sd_bus_message_append(m, b"(sv)", c(b"TasksMax"), c(b"t"), ctypes.c_uint64(SCOPE_TASKS_MAX)) >= 0
        ok &= lib.sd_bus_message_append(m, b"(sv)", c(b"MemoryHigh"), c(b"t"), ctypes.c_uint64(SCOPE_MEM_HIGH)) >= 0
        ok &= lib.sd_bus_message_append(m, b"(sv)", c(b"CollectMode"), c(b"s"), c(b"inactive-or-failed")) >= 0
        ok &= lib.sd_bus_message_close_container(m) >= 0
        ok &= lib.sd_bus_message_append(m, b"a(sa(sv))", ctypes.c_int(0)) >= 0
        if not ok:
            lib.sd_bus_message_unref(m)
            raise OSError("append")
        try:
            r = lib.sd_bus_call(self.bus, m, ctypes.c_uint64(BUS_TIMEOUT_USEC), ctypes.byref(err), ctypes.byref(reply))
            if r < 0:
                raise OSError(f"{(err.name or b'?').decode()}: {(err.message or b'').decode()}")
        finally:
            lib.sd_bus_error_free(ctypes.byref(err))
            lib.sd_bus_message_unref(m)
            if reply.value:
                lib.sd_bus_message_unref(reply)

    def close(self):
        self.lib.sd_bus_flush_close_unref(self.bus)


def branch_ok(fresh, member, root, reason):
    """the member still hangs off the root through non-desktop, non-excluded
    processes, and the root's reason for moving still holds"""
    if member.pid == root.pid:
        if reason == "unconfined build" and not has_agent_or_tmux_above(fresh, member):
            return False
        if reason == "escaped launch" and not member.is_agent:
            m = nearest_marker(fresh, member)
            if m is not None and (m.is_desktop or m.excluded):
                return False
        return True
    for a in ancestors(fresh, member.pid):
        if a.pid == root.pid:
            return True
        if a.is_desktop or a.excluded:
            return False
    return False


def warden_scope_name(root, reason):
    prefix = "agent-warden-build" if reason == "unconfined build" or (reason == "escaped launch" and root.is_build) else "agent-warden"
    return f"{prefix}-{root.pid}-{root.start}.scope"


def move(tree, reason, bus):
    root = tree[0]
    nested = reason == "nested session"
    name = warden_scope_name(root, reason)
    live, fds = [], []
    try:
        fresh = scan()  # ancestry is re-read, not trusted from the planning snapshot
        for i, p in enumerate(tree):
            r = recheck(p, nested)
            if r is not None and not branch_ok(fresh, r[0], root, reason):
                os.close(r[1])
                r = None
            if r is None:
                if i == 0:
                    log(f"  drop tree: root pid {p.pid} ({p.comm}) changed since scan; replanned next tick")
                    return False, name, [], []
                log(f"  skip pid {p.pid} ({p.comm}): identity, cgroup, ancestry or classification changed since scan")
                continue
            live.append(r[0])
            fds.append(r[1])
        try:
            bus.start_scope(name, fds)
        except OSError as e:
            log(f"  StartTransientUnit {name} failed: {e}")
            return False, name, [], live
    finally:
        for fd in fds:
            os.close(fd)
    moved, missing = [], live
    deadline = time.monotonic() + MOVE_VERIFY_SECONDS
    while time.monotonic() < deadline:
        moved, missing = [], []
        for p in live:
            cg = read(f"/proc/{p.pid}/cgroup", "") or ""
            stat = read(f"/proc/{p.pid}/stat", "") or ""
            same = bool(stat) and int(stat.rpartition(")")[2].split()[19]) == p.start
            (moved if same and f"/{name}" in cg else missing).append(p)
        if not missing:
            break
        time.sleep(0.1)
    return not missing, name, moved, missing


# --- machine-readable status --------------------------------------------------
def _now_seconds(now=None):
    return int(time.time() if now is None else now)


def _now_millis(now=None):
    return int((time.time() if now is None else now) * 1000)


def cgroup_dir_state(path):
    try:
        mode = Path(path).stat().st_mode
    except FileNotFoundError:
        return "absent"
    except OSError:
        return "unknown"
    return "present" if stat.S_ISDIR(mode) else "unknown"


def _read_int(path):
    v = read(path)
    if v is None:
        return None
    try:
        return int(v.strip())
    except ValueError:
        return None


def _read_limit(path):
    v = read(path)
    if v is None:
        return None
    v = v.strip()
    if v == "max":
        return "max"
    try:
        return int(v)
    except ValueError:
        return None


def _headroom_status(memory, maximum):
    if memory is None or maximum is None:
        return None
    if maximum == "max":
        return True
    return memory < HEADROOM * maximum


def slice_status():
    base = CG_ROOT / SLICE
    state = cgroup_dir_state(base)
    if state == "absent":
        return None
    if state == "unknown":
        return {
            "memory": None,
            "high": None,
            "max": None,
            "tasks": None,
            "tasksMax": None,
            "headroomOk": None,
        }
    memory = _read_int(base / "memory.current")
    maximum = _read_limit(base / "memory.max")
    return {
        "memory": memory,
        "high": _read_limit(base / "memory.high"),
        "max": maximum,
        "tasks": _read_int(base / "pids.current"),
        "tasksMax": _read_limit(base / "pids.max"),
        "headroomOk": _headroom_status(memory, maximum),
    }


def _tool_label(p):
    for arg in p.argv[:2]:
        m = AGENT_PATH_RE.search(arg)
        if m:
            return MISE_AGENT_NAMES.get(m.group(1))
    return p.comm if p.comm in AGENT_COMMS else p.program or p.comm or None


def _worktree_label(pid):
    try:
        return os.path.basename(os.readlink(f"/proc/{pid}/cwd")) or None
    except OSError:
        return None


def _scope_of_proc(p):
    m = SCOPE_RE.search(p.cgroup or "")
    return m.group(1) if m else None


def lane_label(scope, procs):
    members = [p for p in (procs or {}).values() if _scope_of_proc(p) == scope and p.is_agent]
    if not members:
        return {"tool": None, "worktree": None}
    root = min(members, key=lambda p: (p.start, p.pid))
    return {"tool": _tool_label(root), "worktree": _worktree_label(root.pid)}


def lane_statuses(procs=None):
    base = CG_ROOT / SLICE
    state = cgroup_dir_state(base)
    if state == "absent":
        return []
    if state == "unknown":
        return None
    lanes = []
    try:
        entries = list(base.iterdir())
    except FileNotFoundError:
        return []
    except OSError:
        return None
    for d in sorted(entries, key=lambda p: p.name):
        if not d.name.endswith(".scope"):
            continue
        state = cgroup_dir_state(d)
        if state == "absent":
            continue
        if state == "unknown":
            return None
        tasks = _read_int(d / "pids.current")
        memory = _read_int(d / "memory.current")
        near = []
        if tasks is not None and tasks >= SCOPE_TASKS_WARN:
            near.append("tasks")
        if memory is not None and memory >= SCOPE_MEM_WARN:
            near.append("memory")
        lanes.append({
            "scope": d.name,
            "label": lane_label(d.name, procs),
            "tasks": tasks,
            "tasksMax": _read_limit(d / "pids.max"),
            "memory": memory,
            "memoryHigh": _read_limit(d / "memory.high"),
            "near": near,
        })
    return lanes


def _reason_id(reason):
    return {
        "escaped launch": "escaped-launch",
        "unconfined agent": "unconfined-agent",
        "unconfined build": "unconfined-build",
        "nested session": "nested-session",
    }.get(reason, reason.replace(" ", "-"))


def _tree_status(reason, tree):
    root = tree[0]
    return {
        "reason": _reason_id(reason),
        "pid": root.pid,
        "start": root.start,
        "tool": root.comm,
        "processes": len(tree),
    }


def contained_status(units):
    counts = {}
    for p in units or []:
        unit = unit_of(p.cgroup) or "unknown"
        counts[unit] = counts.get(unit, 0) + 1
    return [{"unit": unit, "processes": counts[unit]} for unit in sorted(counts)]


def _state_readable(st):
    return st.get("_state_readable", True) is not False


STATUS_COUNTER_KEYS_PUBLIC = (("moves", "moves"), ("partial", "partial"), ("reaped", "reaped"),
                              ("moveFailures", "move_failures"), ("scanFailures", "scan_failures"),
                              ("skips", "skips"))


def status_counters(st):
    if not _state_readable(st) or st.get("counters_unknown") is True:
        return {public: None for public, _ in STATUS_COUNTER_KEYS_PUBLIC}
    return {public: int(st.get(internal, 0)) for public, internal in STATUS_COUNTER_KEYS_PUBLIC}


def emit_event(st, kind, *, scope=None, pid=None, processes=None, near=None, now=None):
    if kind not in STATUS_EVENT_KINDS:
        raise ValueError(f"unknown event kind {kind}")
    try:
        previous = int(st.get("event_seq") or 0)
    except (TypeError, ValueError):
        previous = 0
    events = st.get("events") if isinstance(st.get("events"), list) else []
    last_event = max((event.get("id") for event in events
                      if isinstance(event, dict) and isinstance(event.get("id"), int)
                      and not isinstance(event.get("id"), bool)), default=0)
    seq = max(previous + 1, last_event + 1, _now_millis(now))
    st["event_seq"] = seq
    event = {
        "id": seq,
        "time": _now_seconds(now),
        "kind": kind,
        "scope": scope,
        "pid": pid,
        "processes": processes,
        "near": near if kind == "near-cap" else None,
    }
    events.append(event)
    st["events"] = events[-STATUS_EVENT_LIMIT:]
    return event


def record_near_events(st, near_rows, unknown=(), complete=True, now=None):
    current = {f"{unit}:{kind}" for unit, kind, _ in near_rows}
    previous = set(st.get("near_open") or [])
    unknown_keys = {f"{unit}:{kind}" for unit, kind in unknown}
    kept = set(previous) if not complete else previous & unknown_keys
    for unit, kind, _ in sorted(near_rows, key=lambda row: (row[0], row[1])):
        key = f"{unit}:{kind}"
        if key not in previous:
            emit_event(st, "near-cap", scope=unit, near=kind, now=now)
    st["near_open"] = sorted(current | kept)


def record_waiting_events(st, waiting, now=None):
    current = {f"{tree[0].pid}:{tree[0].start}" for _, tree in waiting}
    previous = set(st.get("waiting_open") or [])
    for reason, tree in sorted(waiting, key=lambda item: (item[1][0].pid, item[1][0].start)):
        key = f"{tree[0].pid}:{tree[0].start}"
        if key not in previous:
            emit_event(st, "waiting", scope=warden_scope_name(tree[0], reason),
                       pid=tree[0].pid, processes=len(tree), now=now)
    st["waiting_open"] = sorted(current)


def status_document(mode, st, *, slice_reading, lanes, moves=None, waiting=None,
                    orphans_status=None, contained=None, error=None, now=None):
    return {
        "schema": STATUS_SCHEMA,
        "time": _now_seconds(now),
        "mode": mode,
        "interval": STATUS_INTERVAL,
        "error": error,
        "slice": slice_reading,
        "lanes": lanes,
        "outside": None if moves is None else [_tree_status(reason, tree) for reason, tree in moves],
        "waiting": None if waiting is None else [_tree_status(reason, tree) for reason, tree in waiting],
        "orphans": None if orphans_status is None else sorted(orphans_status, key=lambda row: row["scope"]),
        "contained": None if contained is None else contained_status(contained),
        "events": list(st.get("events") if isinstance(st.get("events"), list) else []),
        "counters": status_counters(st),
    }


def status_from_tick(mode, st, tick, *, slice_reading=None, lanes=None):
    procs = tick.get("procs")
    if tick.get("fresh_labels"):
        try:
            procs = scan()
        except Exception:  # noqa: BLE001
            procs = tick.get("procs")
    return status_document(mode, st, slice_reading=slice_status() if slice_reading is None else slice_reading,
                           lanes=lane_statuses(procs) if lanes is None else lanes,
                           moves=tick.get("moves"), waiting=tick.get("waiting"),
                           orphans_status=tick.get("orphans"), contained=tick.get("contained"),
                           error=tick.get("error"))


def write_status(doc):
    STATUS_DIR = STATE_DIR
    STATUS_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATUS_DIR / f"status.tmp.{os.getpid()}"
    data = (json.dumps(doc, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
    if tmp.exists():
        tmp.unlink()
    fd = None
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        os.fchmod(fd, 0o644)
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise OSError("short status write")
            view = view[written:]
        os.close(fd)
        fd = None
        os.replace(tmp, STATUS)
    except Exception:
        if fd is not None:
            with contextlib.suppress(OSError):
                os.close(fd)
        with contextlib.suppress(FileNotFoundError):
            tmp.unlink()
        raise


def _check_keys(errors, obj, keys, where):
    if not isinstance(obj, dict):
        errors.append(f"{where} must be an object")
        return False
    missing = [k for k in keys if k not in obj]
    if missing:
        errors.append(f"{where} missing {', '.join(missing)}")
        return False
    return True


def _check_int(errors, value, where):
    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
        errors.append(f"{where} must be a non-negative integer")


def _check_int_or_null(errors, value, where):
    if value is not None:
        _check_int(errors, value, where)


def _check_number(errors, value, where):
    if not isinstance(value, (int, float)) or isinstance(value, bool) or not math.isfinite(value):
        errors.append(f"{where} must be a finite number")


def _check_number_or_null(errors, value, where):
    if value is not None:
        _check_number(errors, value, where)


def _check_limit(errors, value, where):
    if value == "max" or value is None:
        return
    _check_int_or_null(errors, value, where)


def _check_events(errors, events, where):
    if not isinstance(events, list):
        errors.append(f"{where} must be a list")
        return
    if len(events) > STATUS_EVENT_LIMIT:
        errors.append(f"{where} must contain at most 50 rows")
    last = -1
    for i, event in enumerate(events):
        row = f"{where}[{i}]"
        if not _check_keys(errors, event, ("id", "time", "kind", "scope", "pid", "processes", "near"), row):
            continue
        if not isinstance(event.get("id"), int) or isinstance(event.get("id"), bool) or event["id"] <= last:
            errors.append(f"{row}.id must increase")
        last = event.get("id") if isinstance(event.get("id"), int) and not isinstance(event.get("id"), bool) else last
        _check_number(errors, event.get("time"), f"{row}.time")
        kind = event.get("kind")
        if not isinstance(kind, str) or kind not in STATUS_EVENT_KINDS:
            errors.append(f"{row}.kind has an unknown id")
        if event.get("scope") is not None and not isinstance(event.get("scope"), str):
            errors.append(f"{row}.scope must be a string or null")
        _check_int_or_null(errors, event.get("pid"), f"{row}.pid")
        _check_int_or_null(errors, event.get("processes"), f"{row}.processes")
        if kind == "near-cap":
            near = event.get("near")
            if not isinstance(near, str) or near not in STATUS_NEAR_KINDS:
                errors.append(f"{row}.near must be tasks or memory")
        elif event.get("near") is not None:
            errors.append(f"{row}.near must be null except for near-cap")


def status_errors(doc):
    errors = []
    top = ("schema", "time", "mode", "interval", "error", "slice", "lanes", "outside",
           "waiting", "orphans", "contained", "events", "counters")
    if not _check_keys(errors, doc, top, "status"):
        return errors
    schema = doc.get("schema")
    if not isinstance(schema, str) or not re.fullmatch(r"1\.\d+", schema):
        errors.append("schema major must be 1")
    _check_number(errors, doc.get("time"), "time")
    mode = doc.get("mode")
    if not isinstance(mode, str) or mode not in {"correct", "report"}:
        errors.append("mode must be correct or report")
    _check_number(errors, doc.get("interval"), "interval")
    if isinstance(doc.get("interval"), (int, float)) and not isinstance(doc.get("interval"), bool) and math.isfinite(doc.get("interval")) and doc.get("interval") <= 0:
        errors.append("interval must be positive")
    error = doc.get("error")
    if error is not None and error != "scan":
        errors.append("error must be scan or null")
    if error is not None:
        for key in ("outside", "waiting", "orphans", "contained"):
            if doc.get(key) is not None:
                errors.append(f"{key} must be null when error is set")
    else:
        for key in ("outside", "waiting", "contained"):
            if not isinstance(doc.get(key), list):
                errors.append(f"{key} must be a list when error is null")
    if doc.get("slice") is not None:
        if _check_keys(errors, doc["slice"], ("memory", "high", "max", "tasks", "tasksMax", "headroomOk"), "slice"):
            _check_int_or_null(errors, doc["slice"].get("memory"), "slice.memory")
            _check_limit(errors, doc["slice"].get("high"), "slice.high")
            _check_limit(errors, doc["slice"].get("max"), "slice.max")
            _check_int_or_null(errors, doc["slice"].get("tasks"), "slice.tasks")
            _check_limit(errors, doc["slice"].get("tasksMax"), "slice.tasksMax")
            if doc["slice"].get("headroomOk") is not None and not isinstance(doc["slice"].get("headroomOk"), bool):
                errors.append("slice.headroomOk must be a boolean or null")
    if doc.get("lanes") is None:
        pass
    elif not isinstance(doc.get("lanes"), list):
        errors.append("lanes must be a list or null")
    else:
        scopes = []
        for i, lane in enumerate(doc["lanes"]):
            where = f"lanes[{i}]"
            if not _check_keys(errors, lane, ("scope", "label", "tasks", "tasksMax", "memory", "memoryHigh", "near"), where):
                continue
            scope = lane.get("scope")
            if not isinstance(scope, str) or not scope.endswith(".scope"):
                errors.append(f"{where}.scope must be a scope name")
            else:
                scopes.append(scope)
            if _check_keys(errors, lane.get("label"), ("tool", "worktree"), f"{where}.label"):
                for key in ("tool", "worktree"):
                    if lane["label"].get(key) is not None and not isinstance(lane["label"].get(key), str):
                        errors.append(f"{where}.label.{key} must be a string or null")
            _check_int_or_null(errors, lane.get("tasks"), f"{where}.tasks")
            _check_limit(errors, lane.get("tasksMax"), f"{where}.tasksMax")
            _check_int_or_null(errors, lane.get("memory"), f"{where}.memory")
            _check_limit(errors, lane.get("memoryHigh"), f"{where}.memoryHigh")
            if not isinstance(lane.get("near"), list) or any(not isinstance(k, str) or k not in STATUS_NEAR_KINDS for k in lane.get("near", [])):
                errors.append(f"{where}.near must contain only tasks or memory")
        if scopes != sorted(scopes):
            errors.append("lanes must be sorted by scope")
    for key in ("outside", "waiting"):
        rows = doc.get(key)
        if rows is None:
            continue
        if not isinstance(rows, list):
            errors.append(f"{key} must be a list or null")
            continue
        for i, row in enumerate(rows):
            where = f"{key}[{i}]"
            if not _check_keys(errors, row, ("reason", "pid", "start", "tool", "processes"), where):
                continue
            reason = row.get("reason")
            if not isinstance(reason, str) or reason not in {"escaped-launch", "unconfined-agent", "unconfined-build", "nested-session"}:
                errors.append(f"{where}.reason has an unknown id")
            for sub in ("pid", "start", "processes"):
                _check_int(errors, row.get(sub), f"{where}.{sub}")
            if not isinstance(row.get("tool"), str):
                errors.append(f"{where}.tool must be a string")
    rows = doc.get("orphans")
    if rows is not None:
        if not isinstance(rows, list):
            errors.append("orphans must be a list or null")
        else:
            for i, row in enumerate(rows):
                where = f"orphans[{i}]"
                if not _check_keys(errors, row, ("scope", "processes", "cores", "since", "harmful"), where):
                    continue
                if not isinstance(row.get("scope"), str):
                    errors.append(f"{where}.scope must be a string")
                _check_int(errors, row.get("processes"), f"{where}.processes")
                _check_number_or_null(errors, row.get("cores"), f"{where}.cores")
                _check_number(errors, row.get("since"), f"{where}.since")
                if not isinstance(row.get("harmful"), bool):
                    errors.append(f"{where}.harmful must be a boolean")
    rows = doc.get("contained")
    if rows is not None:
        if not isinstance(rows, list):
            errors.append("contained must be a list or null")
        else:
            for i, row in enumerate(rows):
                where = f"contained[{i}]"
                if not _check_keys(errors, row, ("unit", "processes"), where):
                    continue
                if not isinstance(row.get("unit"), str):
                    errors.append(f"{where}.unit must be a string")
                _check_int(errors, row.get("processes"), f"{where}.processes")
    _check_events(errors, doc.get("events"), "events")
    if _check_keys(errors, doc.get("counters"), ("moves", "partial", "reaped", "moveFailures", "scanFailures", "skips"), "counters"):
        for key, value in doc["counters"].items():
            _check_int_or_null(errors, value, f"counters.{key}")
    return errors


def _gib(n):
    return n * 1024 ** 3


