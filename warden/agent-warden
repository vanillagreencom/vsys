# Orphan reaper: a scope under agents.slice whose launching agent has exited but
# whose leftover processes keep running. Twice on 2026-09-09/10 this took the
# machine down: an exited lane left 21 `bun` dev servers (16 cores, 7 GiB), and
# another left 5140 `npm view` processes that filled TasksMax and SIGABRT-killed
# every agent on the box. Placement and the mover cannot help: the work is
# already inside the slice, just abandoned. A scope is an orphan when every one
# of its processes has been reparented to init or the user systemd manager (its
# real parent died) and none holds a controlling terminal (nothing interactive
# is attached). Reaped only after ORPHAN_GRACE seconds in that state, so a brief
# reparenting during startup or teardown is never touched.
ORPHAN_GRACE = float(os.environ.get("AGENT_WARDEN_ORPHAN_GRACE", "300"))
REAP = os.environ.get("AGENT_WARDEN_REAP", "1") != "0"
JOB_UNIT_PATTERNS = tuple(x for x in os.environ.get("AGENT_WARDEN_JOB_UNITS", "orch-*.service").split() if x)
SCOPE_RE = re.compile(r"/agents\.slice/([^/]+\.scope)(?:/|$)")
# An orphan is reaped only when it is also HARMFUL, so a quiet abandoned dev or
# preview server (a few idle processes, no CPU) is reported and left alone. The
# two outages both crossed one of these: the npm storm reached 5140 processes in
# one scope; the bun servers each burned ~0.8 of a core. A normal orphaned dev
# server is ~6 idle processes.
ORPHAN_PROC_MAX = int(os.environ.get("AGENT_WARDEN_ORPHAN_PROCS", "40"))
ORPHAN_CPU_CORES = float(os.environ.get("AGENT_WARDEN_ORPHAN_CPU", "0.5"))
# Per-scope task ceiling. The slice as a whole caps at 16384 tasks; without a
# per-scope cap one runaway lane consumes all of it and every other lane dies on
# thread creation (EAGAIN). The cap must protect against a clearly-pathological
# runaway, never bite legitimate work: the largest real lane measured 260 tasks
# and a heavy build peaks in the low hundreds, so 8192 is ~8x any real lane. A
# runaway capped at 8192 still leaves 8192 of the 16384 slice for every other
# lane. The warden warns (below) if a lane ever climbs past SCOPE_TASKS_WARN, so
# a genuinely large legit workload is seen before the cap could limit it.
# agent-confine sets the cap at scope creation; the warden caps only a scope
# left UNBOUNDED (an escapee, a raw systemd-run, an old scope) -- a smaller
# explicit cap or a deliberate larger one is left alone.
SCOPE_CPU_WEIGHT = 99
SCOPE_TASKS_MAX = int(os.environ.get("AGENT_SCOPE_TASKS_MAX", "8192"))
SCOPE_TASKS_WARN = int(os.environ.get("AGENT_SCOPE_TASKS_WARN", str(SCOPE_TASKS_MAX * 3 // 4)))
# Per-scope soft memory ceiling (bytes). A leaking lane reclaims its own pages
# first instead of pressuring the others; soft, so a real build (peak 31 GiB) is
# never killed. Applied to scopes the warden creates; agent-confine sets it at
# launch. 64 GiB default.
SCOPE_MEM_HIGH = int(os.environ.get("AGENT_SCOPE_MEM_HIGH_BYTES", str(64 * 1024**3)))
SCOPE_MEM_WARN = int(os.environ.get("AGENT_SCOPE_MEM_WARN_BYTES", str(SCOPE_MEM_HIGH * 3 // 4)))
