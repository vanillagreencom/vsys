#!/usr/bin/env bash
# Environment caps limit self-oversubscription; slice weight preserves desktop
# share even when a tool overrides those caps. A measured libtest binary used 65
# threads and 2883% CPU on a 32-thread host, so the limits serve different
# needs. CPUWeight requires the in-kernel scheduler; sched_ext ignores it.

set -euo pipefail

# No real-time scheduling for agent work. A lane that requests SCHED_FIFO/RR
# outranks the desktop and the warden on the CPU and can freeze the machine,
# right past CPUWeight (weights only order NORMAL tasks). Lower RLIMIT_RTPRIO to
# 0 (both soft and hard: hard alone fails while soft is higher) so neither this
# process nor anything it starts can take a real-time priority; a non-root
# process cannot raise a hard limit back, and it survives `systemd-run --scope`
# (verified: chrt is refused inside the scope). Set before every exec path.
ulimit -r 0 2>/dev/null || true

CAPS=(
	"RUST_TEST_THREADS=${AGENT_TEST_THREADS:-8}"
	"NEXTEST_TEST_THREADS=${AGENT_TEST_THREADS:-8}"
	"CARGO_BUILD_JOBS=${AGENT_BUILD_JOBS:-16}"
	# Agent harnesses select an exec shell through SHELL. Use bash to avoid fish
	# incompatibilities and zsh nomatch or alias rules; Codex reads passwd and
	# falls back independently.
	"SHELL=/bin/bash"
	# Agent scratch belongs off RAM: use AGENT_TMPDIR or the XDG cache default.
	# Serialize mold links across lanes to avoid disk bursts. Fourteen concurrent
	# links measured about 200 MB each per five seconds; serialization added 0.3 s
	# to a 1.0 s twelve-binary build. An empty AGENT_MOLD_JOBS disables this; mold
	# recognizes only 1.
	"MOLD_JOBS=${AGENT_MOLD_JOBS-1}"
)

# AGENT_TMPDIR (or the XDG default below) names the parent scratch directory
# and never changes. Each lane gets its own subdirectory under it, keyed to
# its own systemd scope, so a cleanup inside one lane's TMPDIR cannot reach
# another's: see the scope-creating exec below, the only place that changes.
AGENT_DEFAULT_TMPDIR="${XDG_CACHE_HOME:-$HOME/.cache}/agents/tmp"
AGENT_EFFECTIVE_TMPDIR="${AGENT_TMPDIR:-$AGENT_DEFAULT_TMPDIR}"

[ $# -gt 0 ] || {
	echo "usage: agent-confine COMMAND [ARGS...]" >&2
	exit 2
}

# Shared build-slot pool (see agent-jobserver). Cargo, rustc, make and ninja
# take a token from this fifo before each unit of work, so the whole fleet
# shares AGENT_JOBSERVER_SLOTS slots plus one implicit slot per Cargo process.
# Exported only when the fifo is really there and the service is up: a stale
# path makes Cargo warn on every build. CARGO_BUILD_JOBS stays as the per-lane
# ceiling for a launch without the pool.
JOBSERVER_FIFO="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agent-jobserver.fifo"
if [ -p "$JOBSERVER_FIFO" ] && systemctl --user is-active --quiet agent-jobserver.service 2>/dev/null; then
	CAPS+=("MAKEFLAGS=--jobserver-auth=fifo:$JOBSERVER_FIFO")
fi

# AGENT_CONFINE marks everything launched through here (children inherit the
# environment). agent-warden classifies by this marker first and by names only
# for what no launcher touched, so a renamed or unlisted CLI cannot hide.
CAPS+=("AGENT_CONFINE=1")

# Already inside the slice: a nested launch (an agent starting an agent) is a
# new session and gets its own sibling scope, so it holds its own CPU share
# instead of splitting its parent's. One exception: when any cgroup between
# here and agents.slice carries a limit of its own (a lane's deliberate
# systemd-run -p MemoryMax=... scope), the child stays inside that limit.
# The helper is named by directory. Exit 0 = capped, 3 = confirmed plain
# lineage; any other outcome (missing helper, python failure, which exits 1
# or 2) keeps the current cgroup: staying inside a limit is the safe error.
if grep -qs 'agents\.slice' /proc/self/cgroup; then
	here=${BASH_SOURCE[0]%/*}
	[ "$here" != "${BASH_SOURCE[0]}" ] || here=$HOME/.local/bin
	cap_status=0
	"$here/agent-confine-lineage-capped" || cap_status=$?
	case $cap_status in
	3) : ;;
	*) exec env "${CAPS[@]}" "$@" ;;
	esac
fi

# Probe for a user manager before exec, since an unavailable manager must not
# prevent the capped launch. Name the scope explicitly: a default systemd-run
# pid-based name can collide with a retained unit. A later failure stays fatal
# because exec leaves no fallback, and silently launching outside the slice
# would hide the failure.
SYSTEMD_SCOPE_ARGS=(--user --quiet --collect --scope --slice=agents.slice)
# systemd before 254 passes scope arguments literally. 254 adds this option;
# 258 expands scope arguments by default. --help tests option parsing without
# contacting the user manager. Both scope calls use the selected arguments.
if command -v systemd-run >/dev/null 2>&1 &&
	systemd-run --expand-environment=no --help >/dev/null 2>&1; then
	SYSTEMD_SCOPE_ARGS+=(--expand-environment=no)
fi
if command -v systemd-run >/dev/null 2>&1 &&
	systemd-run "${SYSTEMD_SCOPE_ARGS[@]}" \
		true >/dev/null 2>&1; then
	# A non-default CPUWeight enables the controller for equal sibling shares: 100
	# measured ineffective and 99 effective. TasksMax contains a runaway in one
	# scope so it cannot consume the whole slice. The measured real-lane maximum is
	# 260 tasks, below the default 8192; a capped runaway leaves half the
	# 16384-task slice. AGENT_SCOPE_TASKS_MAX overrides it. MemoryHigh makes a
	# leaking lane reclaim its own pages before pressuring neighbours. The 64 GiB
	# default is above the measured 31 GiB single-lane peak and is soft;
	# AGENT_SCOPE_MEM_HIGH overrides it. RLIMIT_RTPRIO=0 is set before every exec
	# because LimitRTPRIO is not a scope property. This scope-creating exec alone
	# sets TMPDIR. A scope-keyed directory prevents one lane’s cleanup from
	# reaching another lane’s scratch and lets the warden remove it after the scope
	# ends.
	agent_confine_unit="agent-confine-$$-${RANDOM}"
	agent_confine_scratch="$AGENT_EFFECTIVE_TMPDIR/$agent_confine_unit"
	# Use plain mkdir for the leaf: mkdir -p would hand a name collision another
	# lane’s existing directory. The shared parent still uses -p.
	if mkdir -p -m 700 -- "$AGENT_EFFECTIVE_TMPDIR" 2>/dev/null &&
		mkdir -m 700 -- "$agent_confine_scratch" 2>/dev/null &&
		[ -d "$agent_confine_scratch" ] && [ -w "$agent_confine_scratch" ]; then
		CAPS+=("TMPDIR=$agent_confine_scratch")
	else
		echo "agent-confine: TMPDIR unavailable at $agent_confine_scratch; keeping inherited TMPDIR" >&2
	fi
	exec systemd-run "${SYSTEMD_SCOPE_ARGS[@]}" \
		-p "CPUWeight=99" \
		-p "TasksMax=${AGENT_SCOPE_TASKS_MAX:-8192}" \
		-p "MemoryHigh=${AGENT_SCOPE_MEM_HIGH:-64G}" \
		--unit="$agent_confine_unit" env "${CAPS[@]}" "$@"
fi

# No user manager at all (cron, no session D-Bus, a stripped container). The env
# caps still apply but the slice does not, so say so instead of starting quietly.
echo "agent-confine: no user systemd manager; running OUTSIDE agents.slice" >&2
exec env "${CAPS[@]}" "$@"
