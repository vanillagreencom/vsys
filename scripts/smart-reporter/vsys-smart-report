#!/usr/bin/env bash
# Write one `smartctl -i -A` report per drive, the reports vsys reads drive
# lifetime writes from.
#
#   vsys-smart-report DIR
#
# vsys-smart-report.service runs this as root from vsys-smart-report.timer, and
# it writes DIR/<name>.txt for each /sys/block device with a drive behind it.
# smartctl needs root to open a drive, which is why vsys cannot run it itself.
# smartWrites() in src/collect/devices.ts is the reader of this text.
#
# Environment:
#   SYS_BLOCK        The block device directory to list (default /sys/block).
#   SMARTCTL_TIMEOUT Seconds to let one drive's smartctl run before it is cut
#                     off (default 20). A stalled query or a wedged USB bridge
#                     then costs this one drive's report, not every report
#                     after it. 0 disables the bound entirely, as it does for
#                     `timeout` itself. Raising it by D needs TimeoutStartSec
#                     in vsys-smart-report.service raised by D times the drive
#                     count, not by D: the worst case is every drive's own
#                     deadline, not one of them.
set -euo pipefail
# vsys matches smartctl's field names, so they must be in English.
export LC_ALL=C

dir=${1:?report directory}
sys=${SYS_BLOCK:-/sys/block}
smartctl_timeout=${SMARTCTL_TIMEOUT:-20}
# One probe closes every way `timeout -k 5 -- "$smartctl_timeout"` itself can
# fail, not one failure at a time: a missing timeout command (127), or a
# SMARTCTL_TIMEOUT that is not a duration timeout accepts (125, its own
# "invalid time interval" diagnostic). Either would otherwise land inside
# >"$tmp" 2>&1 below, where `|| true` masks a real drive's smartctl failure
# on purpose, and every drive would silently read as lifetime writes unknown
# instead of the service failing loudly. `true` never itself fails or stalls,
# so a nonzero exit here is the timeout invocation's alone. The `--` ends
# timeout's own option parsing before the duration: without it, an
# option-shaped value such as `--help` is timeout's own flag, not a bad
# duration, and timeout exits 0 having run neither `true` nor smartctl.
probe_error=$(timeout -k 5 -- "$smartctl_timeout" true 2>&1) || {
	printf 'vsys-smart-report: command=timeout misconfigured\n' >&2
	printf '%s\n' "$probe_error" >&2
	printf 'timeout -k 5 -- "%s" could not run. Check SMARTCTL_TIMEOUT and that timeout, from coreutils, is installed, then run this again.\n' "$smartctl_timeout" >&2
	exit 1
}
# A package installs this reporter with smartmontools only an optional
# dependency. With no smartctl every report would hold timeout's own error
# line, and a directory of reports keeps vsys from asking udisks2 instead.
command -v smartctl >/dev/null 2>&1 || {
	printf 'vsys-smart-report: command=smartctl missing\n' >&2
	printf 'This system has no smartctl. Install smartmontools, then run this again.\n' >&2
	exit 1
}
tmp=""
cleanup() {
	if [[ -n $tmp ]]; then rm -f -- "${tmp:?}"; fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
mkdir -p -- "$dir"

for path in "$sys"/*; do
	name=${path##*/}
	# Device mapper, md, loop and zram devices have no drive of their own to
	# ask, and vsys draws no row for a loop, memory, optical or floppy device.
	[[ -e $path/device ]] || continue
	[[ $name =~ ^(loop|ram|zram|sr|fd)[0-9]+$ ]] && continue
	# Each report is written under a hidden name and renamed whole: vsys reads
	# no hidden file, so it never reads a report half written.
	tmp=$dir/.$name.tmp
	# smartctl's exit status is a bit mask that is nonzero for a drive that is
	# failing or has logged errors, which is still a report. A drive it cannot
	# open leaves smartctl's own words and no counter, which vsys reads as
	# lifetime writes unknown. A drive past smartctl_timeout is sent TERM, then
	# KILL 5s later if it is still running; what it wrote before that is the
	# report, and a cut-off report also reads as lifetime writes unknown.
	timeout -k 5 -- "$smartctl_timeout" smartctl -i -A "/dev/$name" >"$tmp" 2>&1 || true
	mv -f -- "$tmp" "$dir/$name.txt"
	tmp=""
done
