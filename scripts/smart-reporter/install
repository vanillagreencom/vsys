#!/usr/bin/env bash
# Install the drive reporter vsys reads lifetime writes from. Run it as root:
#
#   curl -fsSL https://raw.githubusercontent.com/vanillagreencom/vsys/main/scripts/smart-reporter/install | sudo bash
#
# It installs vsys-smart-report, the service and hourly timer that run it, and
# the tmpfiles line that creates its report directory at boot, then starts the
# timer. Every name is vsys's own, so a timer already set up under another
# name keeps working beside it.
#
# The four files come from a tagged release and are checked against that
# release's published SHA256SUMS before anything is installed; a missing or
# mismatched checksum installs nothing.
#
# Environment:
#   VSYS_VERSION           Tag to install from. Defaults to the latest release.
set -euo pipefail

REPO="vanillagreencom/vsys"
WORK=""

die() {
	printf 'smart-reporter: %s\n' "$1" >&2
	exit 1
}

cleanup() {
	if [[ -n $WORK ]]; then rm -rf -- "${WORK:?}"; fi
}

# Nothing runs until the last line calls main, so a download the pipe cut
# short anywhere above it runs nothing.
main() {
	command -v smartctl >/dev/null 2>&1 ||
		die "command=smartctl missing
This system has no smartctl for the reporter to run.
Install the package that ships it, smartmontools on most distributions, then run this again."

	WORK="$(mktemp -d)" || die "scratch=mktemp-failed"
	trap cleanup EXIT

	curl -fsSL "https://raw.githubusercontent.com/${REPO}/main/scripts/reporter-install-lib.sh" \
		-o "$WORK/reporter-install-lib.sh" ||
		die "could not fetch the installer's shared helper."
	# shellcheck source=/dev/null
	source "$WORK/reporter-install-lib.sh" || die "could not load the installer's shared helper."

	reporter_checksum_tool

	local version
	version="$(reporter_resolve_version)"

	reporter_fetch_verified "$version" smart-reporter vsys-smart-report vsys-smart-report.service vsys-smart-report.timer vsys-smart.conf

	install -Dm755 "$WORK/vsys-smart-report" /usr/local/bin/vsys-smart-report
	install -Dm644 "$WORK/vsys-smart-report.service" /etc/systemd/system/vsys-smart-report.service
	install -Dm644 "$WORK/vsys-smart-report.timer" /etc/systemd/system/vsys-smart-report.timer
	install -Dm644 "$WORK/vsys-smart.conf" /etc/tmpfiles.d/vsys-smart.conf
	systemd-tmpfiles --create /etc/tmpfiles.d/vsys-smart.conf
	systemctl daemon-reload
	systemctl enable --now vsys-smart-report.timer
	printf '%s\n' \
		"smart-reporter: installed ${version}" \
		"Drive reports now land in /run/smartctl each hour, the first a minute" \
		"after boot. To write one now: systemctl start vsys-smart-report.service"
}

main "$@"
