#!/usr/bin/env bash
# Install the drive reporter vsys reads lifetime writes from. Run it as root:
#
#   curl -fsSL https://raw.githubusercontent.com/vanillagreencom/vsys/main/scripts/smart-reporter/install | sudo bash
#
# It installs vsys-smart-report, the service and hourly timer that run it, and
# the tmpfiles line that creates its report directory at boot, then starts the
# timer. Every name is vsys's own, so a timer already set up under another
# name keeps working beside it.
#
# The four files come from a tagged release and are checked against that
# release's published SHA256SUMS before anything is installed; a missing or
# mismatched checksum installs nothing.
#
# Environment:
#   VSYS_VERSION           Tag to install from. Defaults to the latest release.
set -euo pipefail

REPO="vanillagreencom/vsys"
WORK=""

die() {
	printf 'smart-reporter: %s\n' "$1" >&2
	exit 1
}

cleanup() {
	if [[ -n $WORK ]]; then rm -rf -- "${WORK:?}"; fi
}

# Nothing runs until the last line calls main, so a download the pipe cut
# short anywhere above it runs nothing.
main() {
	command -v smartctl >/dev/null 2>&1 ||
		die "command=smartctl missing
This system has no smartctl for the reporter to run.
Install the package that ships it, smartmontools on most distributions, then run this again."

	command -v timeout >/dev/null 2>&1 ||
		die "command=timeout missing
This system has no timeout for the reporter to bound smartctl with.
Install coreutils, which ships it on nearly every Linux distribution, then run this again."

	if command -v sha256sum >/dev/null 2>&1; then
		checksum() { sha256sum "$1" | cut -d' ' -f1; }
	elif command -v shasum >/dev/null 2>&1; then
		checksum() { shasum -a 256 "$1" | cut -d' ' -f1; }
	else
		die "command=sha256sum,shasum missing
This installer needs sha256sum or shasum to verify the download."
	fi

	local version="${VSYS_VERSION:-}"
	if [[ -z $version ]]; then
		version=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" |
			sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1) ||
			die "lookup=latest-release failed
Could not reach GitHub to read the latest release tag."
		[[ -n $version ]] || die "lookup=latest-release empty repo=${REPO}
GitHub reported no latest release for ${REPO}."
	fi
	local source="https://raw.githubusercontent.com/${REPO}/${version}/scripts/smart-reporter"
	local sums_url="https://github.com/${REPO}/releases/download/${version}/SHA256SUMS"

	WORK="$(mktemp -d)" || die "scratch=mktemp-failed"
	trap cleanup EXIT

	curl -fsSL "$sums_url" -o "$WORK/SHA256SUMS" ||
		die "download=SHA256SUMS failed release=${version}
Release ${version} publishes no SHA256SUMS; refusing to install an unverified reporter."

	local name sum expected
	for name in vsys-smart-report vsys-smart-report.service vsys-smart-report.timer vsys-smart.conf; do
		curl -fsSL "$source/$name" -o "$WORK/$name" ||
			die "download=$name failed
Could not fetch $source/$name. Nothing was installed."
		if ! expected=$(sed -n "s/^\([0-9a-f]\{64\}\)[[:space:]]\+\*\?${name}\$/\1/p" "$WORK/SHA256SUMS"); then
			die "read=SHA256SUMS failed
Could not read SHA256SUMS."
		fi
		[[ -n $expected ]] || die "checksum=$name unlisted
SHA256SUMS names no checksum for $name; refusing to install unverified."
		if ! sum=$(checksum "$WORK/$name"); then
			die "checksum=$name failed
Could not checksum $name."
		fi
		[[ "$sum" == "$expected" ]] || die "checksum=$name mismatch
Got $sum, release names $expected; nothing was installed."
	done
	install -Dm755 "$WORK/vsys-smart-report" /usr/local/bin/vsys-smart-report
	install -Dm644 "$WORK/vsys-smart-report.service" /etc/systemd/system/vsys-smart-report.service
	install -Dm644 "$WORK/vsys-smart-report.timer" /etc/systemd/system/vsys-smart-report.timer
	install -Dm644 "$WORK/vsys-smart.conf" /etc/tmpfiles.d/vsys-smart.conf
	systemd-tmpfiles --create /etc/tmpfiles.d/vsys-smart.conf
	systemctl daemon-reload
	systemctl enable --now vsys-smart-report.timer
	printf '%s\n' \
		"smart-reporter: installed ${version}" \
		"Drive reports now land in /run/smartctl each hour, the first a minute" \
		"after boot. To write one now: systemctl start vsys-smart-report.service"
}

main "$@"
