#!/usr/bin/env bash
# Write the outcome of one Btrfs scrub as the report vsys reads.
#
#   vsys-scrub-report MOUNT DIR
#
# btrfs-scrub@.service runs this as root after every scrub, through the
# vsys-report.conf drop-in, and it writes DIR/<escaped MOUNT>.result: a summary
# line, then `btrfs scrub status`, then the files the scrub found damaged.
# Naming those files needs root, which is why vsys cannot do it itself.
# docs/architecture/storage-integrity.md holds the format vsys parses.
#
# Environment:
#   BTRFS_SCRUB_MAX_ADDRESSES  Damaged addresses resolved to files (default 64).
set -euo pipefail
# btrfs's own diagnostics are matched below, so they must be in English.
export LC_ALL=C

mnt=${1:?mount point}
dir=${2:?report directory}
name=$(systemd-escape --path "$mnt").result
out=$dir/$name
# The report is written under a hidden name and renamed whole. vsys reads no
# hidden file, so it never reads a report half written, and a run stopped
# part way leaves nothing it would read.
tmp=$dir/.$name.tmp
work=""
cleanup() {
	rm -f -- "$tmp"
	if [[ -n $work ]]; then rm -rf -- "${work:?}"; fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
work=$(mktemp -d)
mkdir -p "$dir"

field() {
	sed -n "/^$1: */{s///p;q}" <<<"$status"
}
# A status that failed still leaves a report: btrfs's own words go into it,
# and the summary says the scrub did not complete.
status=$(btrfs scrub status "$mnt" 2>&1) || true
if ! errors=$(field "Error summary") || ! state=$(field "Status") || ! uuid=$(field "UUID"); then
	echo "vsys-scrub-report: parse=failed mount=$mnt" >&2
	exit 1
fi
result=${SERVICE_RESULT:-unknown}
# btrfs scrub exits 3 when it finds errors, so a finished pass with checksum
# errors shows as SERVICE_RESULT=exit-code; that is a result, not a failure.
# Only `Status: finished` says the filesystem was read end to end.
if [[ $state == finished && $errors == "no errors found" ]]; then
	summary="btrfs scrub finished, no errors: $mnt"
elif [[ $state == finished && -n $errors ]]; then
	summary="btrfs scrub finished, ${errors} (uncorrectable is normal on a single drive): $mnt"
else
	summary="btrfs scrub did not complete (${state:-$result}): $mnt"
fi
{
	echo "$summary"
	echo "$status"
} >"$tmp"

finish() {
	mv -- "$tmp" "$out"
	echo "$summary"
	exit 0
}
# A reading this cannot take names no file. A `Damaged files:` section listing
# no address would tell vsys the scrub found no damaged file, so the report
# carries a sentence instead, which names no files without claiming none.
unnamed() {
	printf '\nThe damaged files are not named: %s\n' "$1" >>"$tmp"
	finish
}
if [[ -z $errors || $errors == "no errors found" ]]; then
	finish
fi

# The devices of this filesystem, by the name the kernel prints for each. A
# logical address means something on one filesystem only, and every Btrfs
# filesystem on the machine writes to one kernel log.
declare -A devices=()
if ! stats=$(btrfs device stats "$mnt" 2>&1); then
	unnamed "btrfs device stats failed: ${stats//$'\n'/; }"
fi
while IFS= read -r line; do
	if [[ $line =~ ^\[(/[^]]+)\]\. ]] && device=$(readlink -f -- "${BASH_REMATCH[1]}"); then
		devices[${device##*/}]=1
	fi
done <<<"$stats"
if ((${#devices[@]} == 0)); then
	unnamed "btrfs device stats named no device of $uuid"
fi

# A start time that does not parse searches the last hour instead.
if ! since=$(date -d "$(field "Scrub started")" '+%Y-%m-%d %H:%M:%S' 2>/dev/null); then
	since="-1h"
fi
if ! kernel=$(journalctl -k --since "$since" --no-pager 2>&1); then
	unnamed "the kernel log could not be read: ${kernel//$'\n'/; }"
fi
# The scrub logs an unrepaired block as `unable to fixup (regular) error at
# logical N`, prefixed by the device. That line is kernel prose, not an
# interface, and it is read only because no interface gives the address:
# `btrfs scrub status` gives counts and no address, and on btrfs-progs v7.1 it
# has no JSON form. A rewording leaves no line matched, and the report then
# lists fewer addresses than the blocks it counts, which vsys shows as unnamed
# damage. The kernel also rate-limits the line, with the same result.
declare -A seen=()
# Kernels since the scrub rewrite put `scrub: ` before the words.
fixup='\(device ([^ ):]+)[^)]*\): (scrub: )?unable to fixup \(regular\) error at logical ([0-9]+)'
while IFS= read -r line; do
	if [[ $line =~ $fixup ]]; then
		device=${BASH_REMATCH[1]}
		address=${BASH_REMATCH[3]}
		if [[ -n ${devices[$device]:-} ]]; then seen[$address]=1; fi
	fi
done <<<"$kernel"
addresses=()
if ((${#seen[@]})); then
	mapfile -t addresses < <(printf '%s\n' "${!seen[@]}" | sort -n)
fi

# The lines one address gets under its heading. vsys lists every name an
# address carries as possibly damaged, so the list is all of the address or
# none of it, and each name reaches the screen byte for byte:
# - every name is checked against the inodes the address belongs to, because
#   btrfs prints a name with a newline in it as two lines, and a line that is
#   not a name of a damaged inode would list an unrelated file;
# - every inode the address belongs to must get a name, because an inode
#   btrfs could not name, or one with no link left, is damage the list would
#   leave out;
# - a name the line format cannot carry exactly, with leading or trailing
#   whitespace or a control character, is not written, because a reader that
#   trims it would name a different file.
# An address that fails any of these lists no name at all.
#
#
# On some kernels the logged address is the start of the 64 KiB block the
# scrub could not repair, rounded down within its block group, not the
# damaged 4 KiB sector (33ce0aa4c576, in v7.3-rc2 and backported to 7.2.7,
# logs the sector itself, and a report does not say which kernel wrote it).
# Resolving only that one address can miss the damaged file when it sits at
# a later sector, so each of the block's 16 sectors is resolved on its own,
# and every file any of them names is listed. A resolver answer that no
# extent holds a sector is never free space on its own, because this
# reporter's own 64 KiB grid cannot be checked against the block group's
# real alignment; only a block where none of its 16 sectors holds an extent
# reads as unresolved rather than damage this report cannot name.
sector_bytes=4096
sectors_per_block=16
no_extent() {
	echo "  (not resolved: no extent holds this address or any other 4 KiB sector of its 64 KiB block)"
}
# One exact logical address: one 4 KiB sector. Prints each name the sector's
# extent is reachable under, one per line, and exits 0. Exits 1 and prints
# nothing when no extent holds this sector, which is not on its own a
# resolution failure: ordinary free space sits inside a damaged block too.
# Exits 2 and prints one reason when resolution failed for a real cause, so
# the caller can still report it when no sector in the block resolved.
resolve_sector() {
	local address=$1 refs names line inode root
	local -A held=()
	if ! refs=$(btrfs inspect-internal logical-resolve -P -o "$address" "$mnt" 2>&1); then
		if [[ $refs == *"logical ino ioctl: No such file or directory"* ]]; then
			return 1
		fi
		echo "${refs//$'\n'/; }"
		return 2
	fi
	while read -r line; do
		if [[ $line =~ ^inode\ ([0-9]+)\ offset\ [0-9]+\ root\ ([0-9]+)$ ]]; then
			held[${BASH_REMATCH[1]}/${BASH_REMATCH[2]}]=1
		fi
	done <<<"$refs"
	if ((${#held[@]} == 0)); then
		return 1
	fi
	if ! names=$(btrfs inspect-internal logical-resolve -o "$address" "$mnt" 2>"$work/error" | sort -u) ||
		[[ -s $work/error ]]; then
		# btrfs reports a failure to name one inode on stderr and still exits
		# 0 when a later inode resolved.
		echo "$(tr '\n' ' ' <"$work/error")"
		return 2
	fi
	if [[ -z $names ]]; then
		echo "btrfs printed no name for a damaged inode"
		return 2
	fi
	local listed=()
	local -A named=()
	while IFS= read -r line; do
		if [[ $line == *"could not be accessed"* ]]; then
			echo "$line"
			return 2
		fi
		if [[ $line =~ ^[[:space:]] || $line =~ [[:space:]]$ || $line =~ [[:cntrl:]] ]]; then
			echo "a name holds whitespace at an end or a control character, which this report cannot carry exactly"
			return 2
		fi
		# The containing directory answers for the subvolume: rootid opens a
		# regular file for writing, which a read-only snapshot refuses.
		if [[ $line != /* ]] || ! inode=$(stat -c %i -- "$line" 2>/dev/null) ||
			! root=$(btrfs inspect-internal rootid "${line%/*}/" 2>/dev/null) ||
			[[ -z ${held[$inode/$root]:-} ]]; then
			echo "a name btrfs printed is not a name of a damaged inode"
			return 2
		fi
		named[$inode/$root]=1
		listed+=("$line")
	done <<<"$names"
	local key
	for key in "${!held[@]}"; do
		if [[ -z ${named[$key]:-} ]]; then
			echo "inode ${key%/*} in subvolume ${key#*/} has no name"
			return 2
		fi
	done
	printf '%s\n' "${listed[@]}"
}
# The 64 KiB block the kernel logged this address as the start of. Every one
# of its 16 sectors is resolved, and the union of every name any of them
# gives is listed: a real resolution failure at one sector never hides a
# name a different sector of the same block proved, because that name is
# still a file the block's damage may sit in.
resolve() {
	local address=$1 sector reason rc failure=""
	local -A names=()
	for ((sector = 0; sector < sectors_per_block; sector++)); do
		if reason=$(resolve_sector "$((address + sector * sector_bytes))"); then
			rc=0
		else
			rc=$?
		fi
		if ((rc == 0)); then
			while IFS= read -r line; do
				[[ -n $line ]] && names[$line]=1
			done <<<"$reason"
		elif ((rc == 2)) && [[ -z $failure ]]; then
			failure=$reason
		fi
	done
	if ((${#names[@]})); then
		printf '%s\n' "${!names[@]}" | sort | sed 's/^/  /'
	elif [[ -n $failure ]]; then
		echo "  (not resolved: $failure)"
	else
		no_extent "$address"
	fi
}

max_addresses=${BTRFS_SCRUB_MAX_ADDRESSES:-64}
{
	echo
	if ((${#addresses[@]} == 0)); then
		echo "Damaged files: no line in the kernel log for this run named an address."
	else
		echo "Damaged files: ${#addresses[@]} damaged block addresses from the kernel log."
		echo "On some kernels each address is the start of a 64 KiB block the scrub could not repair, not the damaged sector, so each of the block's 4 KiB sectors is resolved on its own: more than one file can share a block, and a listed file may be sound."
		echo "Paths are resolved as the scrub ends; a block freed and reused later resolves to an unrelated file."
		for address in "${addresses[@]:0:$max_addresses}"; do
			echo "logical $address:"
			resolve "$address"
		done
		if ((${#addresses[@]} > max_addresses)); then
			echo "($((${#addresses[@]} - max_addresses)) more addresses not resolved; raise BTRFS_SCRUB_MAX_ADDRESSES)"
		fi
	fi
} >>"$tmp"
finish
