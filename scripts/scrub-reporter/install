#!/usr/bin/env bash
# Install the Btrfs scrub reporter vsys reads. Run it as root:
#
#   curl -fsSL https://raw.githubusercontent.com/vanillagreencom/vsys/main/scripts/scrub-reporter/install | sudo bash
#
# It installs vsys-scrub-report, the btrfs-scrub@.service drop-in that runs it
# after every scrub, and the tmpfiles line that creates its report directory,
# under /var/lib so a report outlives a reboot. Every name is vsys's own, so a
# reporter already set up under another name keeps working beside it. It
# schedules no scrub: enabling btrfs-scrub@<mount>.timer for each filesystem
# stays the reader's choice.
#
# The three files come from a tagged release and are checked against that
# release's published SHA256SUMS before anything is installed; a missing or
# mismatched checksum installs nothing.
#
# A machine already running the old tmpfs default (/run/btrfs-scrub) keeps
# whatever it reported since boot only until this install takes effect, so
# any report found there is copied into the persistent directory, never
# overwriting a report already there.
#
# Environment:
#   VSYS_VERSION           Tag to install from. Defaults to the latest release.
#
# VSYS_SCRUB_DIR and VSYS_SCRUB_LEGACY_DIR below are internal test seams; an
# operator running the curl|bash line above sets neither, and the reporter
# always persists reports to the directory named in the installed
# vsys-report.conf, matching vsys's own scrubDir.
#   VSYS_SCRUB_DIR         Where migrate_legacy_reports copies old reports, so a test can point it at a scratch directory instead of the real /var/lib. It does not change where the installed reporter writes.
#   VSYS_SCRUB_LEGACY_DIR  Previous tmpfs report directory to migrate from (default /run/btrfs-scrub).
set -euo pipefail

REPO="vanillagreencom/vsys"
SCRUB_DIR="${VSYS_SCRUB_DIR:-/var/lib/btrfs-scrub}"
LEGACY_SCRUB_DIR="${VSYS_SCRUB_LEGACY_DIR:-/run/btrfs-scrub}"
WORK=""

die() {
	printf 'scrub-reporter: %s\n' "$1" >&2
	exit 1
}

cleanup() {
	if [[ -n $WORK ]]; then rm -rf -- "${WORK:?}"; fi
}

# Nothing runs until the last line calls main, so a download the pipe cut
# short anywhere above it runs nothing.
main() {
	if command -v sha256sum >/dev/null 2>&1; then
		checksum() { sha256sum "$1" | cut -d' ' -f1; }
	elif command -v shasum >/dev/null 2>&1; then
		checksum() { shasum -a 256 "$1" | cut -d' ' -f1; }
	else
		die "this installer needs sha256sum or shasum to verify the download."
	fi

	systemctl cat btrfs-scrub@.service >/dev/null 2>&1 ||
		die "unit=btrfs-scrub@.service missing
This system has no btrfs-scrub@.service for the reporter to run after.
Install the package that ships it, btrfs-progs on Arch Linux, then run this again."

	local version="${VSYS_VERSION:-}"
	if [[ -z $version ]]; then
		version=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" |
			sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1) ||
			die "could not reach GitHub to read the latest release tag."
		[[ -n $version ]] || die "GitHub reported no latest release for ${REPO}."
	fi
	local source="https://raw.githubusercontent.com/${REPO}/${version}/scripts/scrub-reporter"
	local sums_url="https://github.com/${REPO}/releases/download/${version}/SHA256SUMS"

	WORK="$(mktemp -d)" || die "scratch=mktemp-failed"
	trap cleanup EXIT

	curl -fsSL "$sums_url" -o "$WORK/SHA256SUMS" ||
		die "release ${version} publishes no SHA256SUMS; refusing to install an unverified reporter."

	local name sum expected
	for name in vsys-scrub-report vsys-report.conf vsys-scrub.conf; do
		curl -fsSL "$source/$name" -o "$WORK/$name" ||
			die "download=$name failed
Could not fetch $source/$name. Nothing was installed."
		if ! expected=$(sed -n "s/^\([0-9a-f]\{64\}\)[[:space:]]\+\*\?${name}\$/\1/p" "$WORK/SHA256SUMS"); then
			die "could not read SHA256SUMS."
		fi
		[[ -n $expected ]] || die "SHA256SUMS names no checksum for $name; refusing to install unverified."
		if ! sum=$(checksum "$WORK/$name"); then
			die "could not checksum $name."
		fi
		[[ "$sum" == "$expected" ]] || die "checksum mismatch for $name; nothing was installed."
	done
	local exec_line report_dir
	exec_line="$(grep -m1 '^ExecStopPost=' "$WORK/vsys-report.conf")" ||
		die "parse=vsys-report.conf-missing-execstoppost
The downloaded vsys-report.conf has no ExecStopPost= line, so the directory it makes the reporter write to could not be read. Nothing was installed."
	report_dir="${exec_line##* }"
	[[ $report_dir == /* ]] ||
		die "parse=vsys-report.conf-bad-execstoppost value=$exec_line
Could not read the report directory from vsys-report.conf's ExecStopPost= line. Nothing was installed."
	install -Dm755 "$WORK/vsys-scrub-report" /usr/local/bin/vsys-scrub-report
	install -Dm644 "$WORK/vsys-report.conf" /etc/systemd/system/btrfs-scrub@.service.d/vsys-report.conf
	install -Dm644 "$WORK/vsys-scrub.conf" /etc/tmpfiles.d/vsys-scrub.conf
	systemd-tmpfiles --create /etc/tmpfiles.d/vsys-scrub.conf
	systemctl daemon-reload
	migrate_legacy_reports
	printf '%s\n' \
		"scrub-reporter: installed ${version}" \
		"Each scrub now leaves a report in $report_dir, which survives a reboot." \
		"To check a filesystem on a schedule, enable its timer, for example:" \
		"  systemctl enable --now btrfs-scrub@-.timer"
}

# A machine already running the tmpfs default has whatever it reported since
# boot sitting in LEGACY_SCRUB_DIR; copy it into SCRUB_DIR now, before a
# reboot clears it, without overwriting a report already there. This runs
# after the core install already succeeded, so its own failures are
# reported as a carry-over problem, not an install failure.
#
# LEGACY_SCRUB_DIR can outlive the whole boot, so this can run while
# vsys-scrub-report is writing a report for the same mount. Migration's own
# temp names (.migrate.<name>.tmp) are never the reporter's own
# (.<name>.tmp), so the stray-cleanup sweep below can never remove a report
# the reporter is actively writing. The final publish is a no-clobber
# rename, read by whether the temp name survives it rather than by its exit
# status (unpatched coreutils 9.2-9.4 can report failure on a skipped
# destination), so a fresh report the reporter just finished writing for
# that mount always wins over the stale legacy one, whenever it lands.
migrate_legacy_reports() {
	[[ -d $LEGACY_SCRUB_DIR && $LEGACY_SCRUB_DIR != "$SCRUB_DIR" ]] || return 0
	mkdir -p -- "$SCRUB_DIR" 2>/dev/null ||
		die "legacy-migrate=mkdir-failed dir=$SCRUB_DIR
The reporter is installed and will run after the next scrub. Could not create $SCRUB_DIR to carry its old reports over from $LEGACY_SCRUB_DIR, so they stay there until a reboot clears them."
	local stray
	for stray in "$SCRUB_DIR"/.migrate.*.result.tmp; do
		[[ -e $stray ]] || continue
		rm -f -- "$stray"
	done
	local report name dest tmp
	for report in "$LEGACY_SCRUB_DIR"/*.result; do
		[[ -e $report ]] || continue
		name="${report##*/}"
		dest="$SCRUB_DIR/$name"
		[[ -e $dest ]] && continue
		tmp="$SCRUB_DIR/.migrate.$name.tmp"
		cp -- "$report" "$tmp" 2>/dev/null ||
			die "legacy-migrate=copy-failed report=$report
The reporter is installed and will run after the next scrub. Could not carry $report over into $SCRUB_DIR, so it stays in $LEGACY_SCRUB_DIR until a reboot clears it."
		mv -n -- "$tmp" "$dest" 2>/dev/null
		if [[ -e $tmp ]]; then
			rm -f -- "$tmp"
			[[ -e $dest ]] ||
				die "legacy-migrate=copy-failed report=$report
The reporter is installed and will run after the next scrub. Could not carry $report over into $SCRUB_DIR, so it stays in $LEGACY_SCRUB_DIR until a reboot clears it."
		fi
	done
}

main "$@"
