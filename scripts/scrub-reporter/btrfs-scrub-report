#!/usr/bin/env bash
# Write the outcome of one Btrfs scrub as the report vsys reads.
#
#   btrfs-scrub-report MOUNT DIR
#
# btrfs-scrub@.service runs this as root after every scrub, through the
# vsys-report.conf drop-in, and it writes DIR/<escaped MOUNT>.result: a summary
# line, then `btrfs scrub status`, then the files the scrub found damaged.
# Naming those files needs root, which is why vsys cannot do it itself.
# docs/architecture/storage-integrity.md holds the format vsys parses.
#
# Environment:
#   BTRFS_SCRUB_MAX_ADDRESSES  Damaged addresses resolved to files (default 64).
set -euo pipefail

mnt=${1:?mount point}
dir=${2:?report directory}
out=$dir/$(systemd-escape --path "$mnt").result
mkdir -p "$dir"
# A status that failed still leaves a report: btrfs's own words go into it,
# and the summary says the scrub did not complete.
status=$(btrfs scrub status "$mnt" 2>&1) || true
if ! errors=$(sed -n 's/^Error summary: *//p' <<<"$status"); then
	echo "btrfs-scrub-report: parse=failed mount=$mnt" >&2
	exit 1
fi
result=${SERVICE_RESULT:-unknown}
# btrfs scrub exits 3 when it finds errors, so a finished pass with checksum
# errors shows as SERVICE_RESULT=exit-code; that is a result, not a failure.
if [[ $errors == "no errors found" ]]; then
	summary="btrfs scrub finished, no errors: $mnt"
elif [[ -n $errors ]]; then
	summary="btrfs scrub finished, ${errors} (uncorrectable is normal on a single drive): $mnt"
else
	summary="btrfs scrub did not complete ($result): $mnt"
fi
{
	echo "$summary"
	echo "$status"
} >"$out.tmp"

# Name the damaged files. The scrub prints a path for almost none of them (the
# kernel rate-limits that warning), but it logs every unfixable address, and
# `logical-resolve` turns an address into its names. One extent can carry
# several names: a cargo build script writes both `build-script-build` and
# `build_script_build-<hash>`, so deleting the first alone leaves the damage
# in place and the next scrub finds it again. Every name for an address is
# listed under it, and the reader deletes all of them.
max_addresses=${BTRFS_SCRUB_MAX_ADDRESSES:-64}
if [[ -n $errors && $errors != "no errors found" ]]; then
	# A start time that does not parse searches the last hour instead.
	if ! since=$(date -d "$(sed -n '/^Scrub started: */{s///p;q}' <<<"$status")" '+%Y-%m-%d %H:%M:%S' 2>/dev/null); then
		since=""
	fi
	# A kernel log this cannot read names no address, and a section listing
	# none would tell vsys the scrub found no damaged file. The report carries
	# no section instead, which names no files without claiming there are none.
	if ! kernel=$(journalctl -k --since "${since:--1h}" --no-pager 2>&1); then
		printf '\nThe kernel log could not be read, so this report names no damaged file: %s\n' "$kernel" >>"$out.tmp"
		mv "$out.tmp" "$out"
		echo "$summary"
		exit 0
	fi
	mapfile -t addresses < <(
		sed -nE 's/.*unable to fixup \(regular\) error at logical ([0-9]+).*/\1/p' <<<"$kernel" |
			sort -un
	)
	{
		echo
		if ((${#addresses[@]} == 0)); then
			echo "Damaged files: no unfixable address in the kernel log for this run."
		else
			echo "Damaged files: ${#addresses[@]} damaged block addresses from the kernel log."
			echo "Delete every path listed under an address, not the first: one block can have several names."
			echo "Paths are resolved as the scrub ends; a block freed and reused later resolves to an unrelated file."
			for address in "${addresses[@]:0:$max_addresses}"; do
				echo "logical $address:"
				# logical-resolve fails for an address no file holds.
				if ! paths=$(btrfs inspect-internal logical-resolve -o "$address" "$mnt" 2>/dev/null | sort -u) || [[ -z $paths ]]; then
					echo "  (no file: free space, or already deleted)"
				else
					sed 's/^/  /' <<<"$paths"
				fi
			done
			if ((${#addresses[@]} > max_addresses)); then
				echo "($((${#addresses[@]} - max_addresses)) more addresses not resolved; raise BTRFS_SCRUB_MAX_ADDRESSES)"
			fi
		fi
	} >>"$out.tmp"
fi

mv "$out.tmp" "$out"
echo "$summary"
